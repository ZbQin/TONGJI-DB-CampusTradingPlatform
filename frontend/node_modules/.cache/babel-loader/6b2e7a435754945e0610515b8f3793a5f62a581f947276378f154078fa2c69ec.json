{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport NavBar from '@/components/NavBar.vue';\nimport { ElMessage } from 'element-plus';\n// import { getProductDetail } from '@/api/product'\n\nexport default {\n  __name: 'ProductDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const product = ref({});\n    onMounted(async () => {\n      const id = route.params.id;\n      // TODO: 调用API获取详情\n      // const res = await getProductDetail(id)\n      // product.value = res.data\n\n      // 模拟数据\n      product.value = {\n        id: id,\n        title: '示例商品 - 99新 iPad Air 5',\n        price: 3500.00,\n        seller: '张三',\n        time: '2023-10-20',\n        category: '电子数码',\n        description: '去年买的，一直带壳贴膜使用，无划痕，电池健康98%。配件齐全，带原装盒子。',\n        image: ''\n      };\n    });\n    const handleContact = () => {\n      ElMessage.info('聊天功能开发中...');\n    };\n    const handleCollect = () => {\n      ElMessage.success('收藏成功');\n    };\n    const __returned__ = {\n      route,\n      product,\n      handleContact,\n      handleCollect,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      NavBar,\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","NavBar","ElMessage","route","product","id","params","value","title","price","seller","time","category","description","image","handleContact","info","handleCollect","success"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/ProductDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"detail-container\">\r\n    <NavBar />\r\n    \r\n    <div class=\"content-wrapper\">\r\n      <el-card class=\"product-detail-card\">\r\n        <div class=\"product-layout\">\r\n          <!-- 左侧图片 -->\r\n          <div class=\"image-section\">\r\n            <div class=\"main-image\">\r\n              <img v-if=\"product.image\" :src=\"product.image\" />\r\n              <div v-else class=\"no-image\">暂无图片</div>\r\n            </div>\r\n          </div>\r\n          \r\n          <!-- 右侧信息 -->\r\n          <div class=\"info-section\">\r\n            <h1 class=\"title\">{{ product.title }}</h1>\r\n            \r\n            <div class=\"price-box\">\r\n              <span class=\"currency\">¥</span>\r\n              <span class=\"price\">{{ product.price }}</span>\r\n            </div>\r\n            \r\n            <div class=\"meta-info\">\r\n              <div class=\"meta-item\">\r\n                <span class=\"label\">卖家：</span>\r\n                <span class=\"value\">{{ product.seller }}</span>\r\n              </div>\r\n              <div class=\"meta-item\">\r\n                <span class=\"label\">发布时间：</span>\r\n                <span class=\"value\">{{ product.time }}</span>\r\n              </div>\r\n              <div class=\"meta-item\">\r\n                <span class=\"label\">分类：</span>\r\n                <el-tag size=\"small\">{{ product.category }}</el-tag>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"description-box\">\r\n              <div class=\"label\">商品详情：</div>\r\n              <div class=\"content\">{{ product.description }}</div>\r\n            </div>\r\n            \r\n            <div class=\"action-buttons\">\r\n              <el-button type=\"primary\" size=\"large\" @click=\"handleContact\">联系卖家</el-button>\r\n              <el-button size=\"large\" @click=\"handleCollect\">收藏商品</el-button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useRoute } from 'vue-router'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { ElMessage } from 'element-plus'\r\n// import { getProductDetail } from '@/api/product'\r\n\r\nconst route = useRoute()\r\nconst product = ref({})\r\n\r\nonMounted(async () => {\r\n  const id = route.params.id\r\n  // TODO: 调用API获取详情\r\n  // const res = await getProductDetail(id)\r\n  // product.value = res.data\r\n  \r\n  // 模拟数据\r\n  product.value = {\r\n    id: id,\r\n    title: '示例商品 - 99新 iPad Air 5',\r\n    price: 3500.00,\r\n    seller: '张三',\r\n    time: '2023-10-20',\r\n    category: '电子数码',\r\n    description: '去年买的，一直带壳贴膜使用，无划痕，电池健康98%。配件齐全，带原装盒子。',\r\n    image: ''\r\n  }\r\n})\r\n\r\nconst handleContact = () => {\r\n  ElMessage.info('聊天功能开发中...')\r\n}\r\n\r\nconst handleCollect = () => {\r\n  ElMessage.success('收藏成功')\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.detail-container {\r\n  min-height: 100vh;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.content-wrapper {\r\n  max-width: 1000px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n.product-layout {\r\n  display: flex;\r\n  gap: 40px;\r\n}\r\n\r\n.image-section {\r\n  flex: 1;\r\n  max-width: 400px;\r\n}\r\n\r\n.main-image {\r\n  width: 100%;\r\n  height: 400px;\r\n  background-color: #f5f7fa;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.main-image img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.no-image {\r\n  color: #909399;\r\n}\r\n\r\n.info-section {\r\n  flex: 1;\r\n}\r\n\r\n.title {\r\n  font-size: 24px;\r\n  color: #303133;\r\n  margin: 0 0 20px;\r\n}\r\n\r\n.price-box {\r\n  background-color: #fef0f0;\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  margin-bottom: 20px;\r\n  color: #f56c6c;\r\n}\r\n\r\n.currency {\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n}\r\n\r\n.price {\r\n  font-size: 32px;\r\n  font-weight: bold;\r\n  margin-left: 5px;\r\n}\r\n\r\n.meta-info {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.meta-item {\r\n  margin-bottom: 10px;\r\n  font-size: 14px;\r\n  color: #606266;\r\n}\r\n\r\n.meta-item .label {\r\n  color: #909399;\r\n  margin-right: 10px;\r\n}\r\n\r\n.description-box {\r\n  margin-bottom: 30px;\r\n  border-top: 1px solid #ebeef5;\r\n  padding-top: 20px;\r\n}\r\n\r\n.description-box .label {\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n  color: #303133;\r\n}\r\n\r\n.description-box .content {\r\n  line-height: 1.6;\r\n  color: #606266;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .product-layout {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .image-section {\r\n    max-width: 100%;\r\n  }\r\n  \r\n  .main-image {\r\n    height: 300px;\r\n  }\r\n}\r\n</style>"],"mappings":"AAwDA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,SAASC,QAAQ,QAAQ,YAAY;AACrC,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,SAAS,QAAQ,cAAc;AACxC;;;;;;;;IAEA,MAAMC,KAAK,GAAGH,QAAQ,CAAC,CAAC;IACxB,MAAMI,OAAO,GAAGN,GAAG,CAAC,CAAC,CAAC,CAAC;IAEvBC,SAAS,CAAC,YAAY;MACpB,MAAMM,EAAE,GAAGF,KAAK,CAACG,MAAM,CAACD,EAAE;MAC1B;MACA;MACA;;MAEA;MACAD,OAAO,CAACG,KAAK,GAAG;QACdF,EAAE,EAAEA,EAAE;QACNG,KAAK,EAAE,uBAAuB;QAC9BC,KAAK,EAAE,OAAO;QACdC,MAAM,EAAE,IAAI;QACZC,IAAI,EAAE,YAAY;QAClBC,QAAQ,EAAE,MAAM;QAChBC,WAAW,EAAE,uCAAuC;QACpDC,KAAK,EAAE;MACT,CAAC;IACH,CAAC,CAAC;IAEF,MAAMC,aAAa,GAAGA,CAAA,KAAM;MAC1Bb,SAAS,CAACc,IAAI,CAAC,YAAY,CAAC;IAC9B,CAAC;IAED,MAAMC,aAAa,GAAGA,CAAA,KAAM;MAC1Bf,SAAS,CAACgB,OAAO,CAAC,MAAM,CAAC;IAC3B,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
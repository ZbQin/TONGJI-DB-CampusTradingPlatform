{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport { ref, reactive, computed, onMounted, nextTick, watch } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport NavBar from '@/components/NavBar.vue';\nimport { Delete, Picture, Promotion } from '@element-plus/icons-vue';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport { getSessionList, getMessageList, sendMessage, markMessagesRead, uploadChatImage, deleteSession } from '@/api/chat';\nexport default {\n  __name: 'Chat',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const store = useStore();\n    const sessions = ref([]);\n    const messages = ref([]);\n    const currentSessionId = ref(null);\n    const messageInput = ref('');\n    const sending = ref(false);\n    const messageScrollbar = ref(null);\n    const userInfo = computed(() => store.state.userInfo || {});\n    const currentUserId = computed(() => userInfo.value.user_id || null);\n    const currentSession = computed(() => {\n      if (!currentSessionId.value) return null;\n      const session = sessions.value.find(s => s.session_id === currentSessionId.value);\n      if (!session) return null;\n      return {\n        name: getOtherUserName(session),\n        avatar: getOtherUserAvatar(session)\n      };\n    });\n    const totalUnread = computed(() => {\n      return sessions.value.reduce((sum, session) => sum + (session.unread_count || 0), 0);\n    });\n\n    // 获取对方用户名\n    const getOtherUserName = session => {\n      const isCurrentUserBuyer = session.buyer_id === currentUserId.value;\n      // 可以从会话中获取用户信息，或通过API获取\n      return isCurrentUserBuyer ? `卖家 #${session.seller_id}` : `买家 #${session.buyer_id}`;\n    };\n\n    // 获取对方用户头像\n    const getOtherUserAvatar = session => {\n      // 可以从会话中获取用户信息，或通过API获取\n      return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    };\n\n    // 格式化时间\n    const formatTime = timeStr => {\n      if (!timeStr) return '';\n      const date = new Date(timeStr);\n      const now = new Date();\n      const diff = now - date;\n      if (diff < 60000) return '刚刚';\n      if (diff < 3600000) return `${Math.floor(diff / 60000)}分钟前`;\n      if (diff < 86400000) return `${Math.floor(diff / 3600000)}小时前`;\n      return `${date.getMonth() + 1}-${date.getDate()}`;\n    };\n\n    // 加载会话列表\n    const loadSessions = async () => {\n      try {\n        const res = await getSessionList();\n        if (res.code === 200) {\n          sessions.value = res.data.list || [];\n        }\n      } catch (error) {\n        ElMessage.error('加载会话列表失败');\n      }\n    };\n\n    // 选择会话\n    const selectSession = async sessionId => {\n      currentSessionId.value = sessionId;\n      await loadMessages(sessionId);\n      await markRead(sessionId);\n    };\n\n    // 加载消息列表\n    const loadMessages = async sessionId => {\n      try {\n        const res = await getMessageList(sessionId);\n        if (res.code === 200) {\n          messages.value = res.data.list || [];\n          await nextTick();\n          scrollToBottom();\n        } else {\n          ElMessage.error(res.data.message);\n        }\n      } catch (error) {\n        ElMessage.error('加载消息失败');\n      }\n    };\n\n    // 标记为已读\n    const markRead = async sessionId => {\n      try {\n        await markMessagesRead(sessionId);\n        // 更新会话列表中的未读数\n        const session = sessions.value.find(s => s.session_id === sessionId);\n        if (session) {\n          session.unread_count = 0;\n        }\n      } catch (error) {\n        console.error('标记已读失败', error);\n      }\n    };\n\n    // 发送消息\n    const handleSendMessage = async () => {\n      if (!messageInput.value.trim()) {\n        ElMessage.warning('请输入消息内容');\n        return;\n      }\n      if (!currentSessionId.value) {\n        ElMessage.warning('请先选择一个会话');\n        return;\n      }\n      if (!currentUserId.value) {\n        ElMessage.error('用户信息未加载，请刷新页面');\n        return;\n      }\n      const session = sessions.value.find(s => s.session_id === currentSessionId.value);\n      if (!session) return;\n      const receiverId = session.buyer_id === currentUserId.value ? session.seller_id : session.buyer_id;\n      sending.value = true;\n      try {\n        const res = await sendMessage({\n          session_id: currentSessionId.value,\n          receiver_id: receiverId,\n          message_type: 0,\n          content: messageInput.value\n        });\n        if (res.code === 200) {\n          messages.value.push(res.data);\n          messageInput.value = '';\n          await nextTick();\n          scrollToBottom();\n\n          // 更新会话列表\n          session.last_message = res.data.content;\n          session.updated_at = res.data.created_at;\n\n          // 将当前会话移到最前\n          sessions.value = [session, ...sessions.value.filter(s => s.session_id !== currentSessionId.value)];\n        } else {\n          ElMessage.error(res.message || '发送失败');\n        }\n      } catch (error) {\n        ElMessage.error('发送失败');\n      } finally {\n        sending.value = false;\n      }\n    };\n\n    // 上传图片\n    const handleImageUpload = async file => {\n      const isImage = file.type.startsWith('image/');\n      const isLt5M = file.size / 1024 / 1024 < 5;\n      if (!isImage) {\n        ElMessage.error('只能上传图片文件!');\n        return false;\n      }\n      if (!isLt5M) {\n        ElMessage.error('图片大小不能超过 5MB!');\n        return false;\n      }\n      if (!currentUserId.value) {\n        ElMessage.error('用户信息未加载，请刷新页面');\n        return false;\n      }\n      try {\n        const res = await uploadChatImage(file);\n        if (res.code === 200) {\n          const session = sessions.value.find(s => s.session_id === currentSessionId.value);\n          if (!session) {\n            ElMessage.error('会话不存在');\n            return false;\n          }\n          const receiverId = session.buyer_id === currentUserId.value ? session.seller_id : session.buyer_id;\n          const msgRes = await sendMessage({\n            session_id: currentSessionId.value,\n            receiver_id: receiverId,\n            message_type: 1,\n            content: res.data.image_url\n          });\n          if (msgRes.code === 200) {\n            messages.value.push(msgRes.data);\n            await nextTick();\n            scrollToBottom();\n          }\n        } else {\n          ElMessage.error(res.message || '上传失败');\n        }\n      } catch (error) {\n        ElMessage.error('上传失败');\n      }\n      return false;\n    };\n\n    // 删除会话\n    const handleDeleteSession = () => {\n      ElMessageBox.confirm('确定删除此会话吗？删除后消息记录将无法恢复。', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await deleteSession(currentSessionId.value);\n          if (res.code === 200) {\n            ElMessage.success('删除成功');\n            sessions.value = sessions.value.filter(s => s.session_id !== currentSessionId.value);\n            currentSessionId.value = null;\n            messages.value = [];\n          } else {\n            ElMessage.error(res.message || '删除失败');\n          }\n        } catch (error) {\n          ElMessage.error('删除失败');\n        }\n      }).catch(() => {});\n    };\n\n    // 滚动到底部\n    const scrollToBottom = () => {\n      if (messageScrollbar.value) {\n        //const scrollElement = messageScrollbar.value.$refs.wrap\n        scrollElement.scrollTop = scrollElement.scrollHeight;\n      }\n    };\n    onMounted(async () => {\n      // 确保用户信息已加载\n      if (!store.state.userInfo || !store.state.userInfo.user_id) {\n        try {\n          await store.dispatch('fetchUserInfo');\n        } catch (error) {\n          ElMessage.error('获取用户信息失败');\n          router.push('/login');\n          return;\n        }\n      }\n      loadSessions();\n    });\n    const __returned__ = {\n      router,\n      store,\n      sessions,\n      messages,\n      currentSessionId,\n      messageInput,\n      sending,\n      messageScrollbar,\n      userInfo,\n      currentUserId,\n      currentSession,\n      totalUnread,\n      getOtherUserName,\n      getOtherUserAvatar,\n      formatTime,\n      loadSessions,\n      selectSession,\n      loadMessages,\n      markRead,\n      handleSendMessage,\n      handleImageUpload,\n      handleDeleteSession,\n      scrollToBottom,\n      ref,\n      reactive,\n      computed,\n      onMounted,\n      nextTick,\n      watch,\n      get useRouter() {\n        return useRouter;\n      },\n      get useStore() {\n        return useStore;\n      },\n      NavBar,\n      get Delete() {\n        return Delete;\n      },\n      get Picture() {\n        return Picture;\n      },\n      get Promotion() {\n        return Promotion;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      get getSessionList() {\n        return getSessionList;\n      },\n      get getMessageList() {\n        return getMessageList;\n      },\n      get sendMessage() {\n        return sendMessage;\n      },\n      get markMessagesRead() {\n        return markMessagesRead;\n      },\n      get uploadChatImage() {\n        return uploadChatImage;\n      },\n      get deleteSession() {\n        return deleteSession;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","computed","onMounted","nextTick","watch","useRouter","useStore","NavBar","Delete","Picture","Promotion","ElMessage","ElMessageBox","getSessionList","getMessageList","sendMessage","markMessagesRead","uploadChatImage","deleteSession","router","store","sessions","messages","currentSessionId","messageInput","sending","messageScrollbar","userInfo","state","currentUserId","value","user_id","currentSession","session","find","s","session_id","name","getOtherUserName","avatar","getOtherUserAvatar","totalUnread","reduce","sum","unread_count","isCurrentUserBuyer","buyer_id","seller_id","formatTime","timeStr","date","Date","now","diff","Math","floor","getMonth","getDate","loadSessions","res","code","data","list","error","selectSession","sessionId","loadMessages","markRead","scrollToBottom","message","console","handleSendMessage","trim","warning","receiverId","receiver_id","message_type","content","push","last_message","updated_at","created_at","filter","handleImageUpload","file","isImage","type","startsWith","isLt5M","size","msgRes","image_url","handleDeleteSession","confirm","confirmButtonText","cancelButtonText","then","success","catch","scrollElement","scrollTop","scrollHeight","dispatch"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/Chat.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-container\">\r\n    <NavBar />\r\n    \r\n    <div class=\"chat-main\">\r\n      <!-- 左侧会话列表 -->\r\n      <div class=\"session-list\">\r\n        <div class=\"session-header\">\r\n          <h3>消息</h3>\r\n          <el-badge :value=\"totalUnread\" :hidden=\"totalUnread === 0\" class=\"unread-badge\" />\r\n        </div>\r\n        \r\n        <el-scrollbar class=\"session-scroll\">\r\n          <div \r\n            v-for=\"session in sessions\" \r\n            :key=\"session.session_id\"\r\n            :class=\"['session-item', { active: currentSessionId === session.session_id }]\"\r\n            @click=\"selectSession(session.session_id)\"\r\n          >\r\n            <el-avatar :size=\"50\" :src=\"getOtherUserAvatar(session)\" />\r\n            <div class=\"session-info\">\r\n              <div class=\"session-top\">\r\n                <span class=\"session-name\">{{ getOtherUserName(session) }}</span>\r\n                <span class=\"session-time\">{{ formatTime(session.updated_at) }}</span>\r\n              </div>\r\n              <div class=\"session-bottom\">\r\n                <span class=\"last-message\">{{ session.last_message || '暂无消息' }}</span>\r\n                <el-badge \r\n                  v-if=\"session.unread_count > 0\" \r\n                  :value=\"session.unread_count\" \r\n                  class=\"unread-count\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <el-empty v-if=\"sessions.length === 0\" description=\"暂无聊天记录\" />\r\n        </el-scrollbar>\r\n      </div>\r\n\r\n      <!-- 右侧聊天区域 -->\r\n      <div class=\"chat-area\">\r\n        <div v-if=\"!currentSessionId\" class=\"no-session\">\r\n          <el-empty description=\"请选择一个会话开始聊天\" />\r\n        </div>\r\n        \r\n        <template v-else>\r\n          <!-- 聊天头部 -->\r\n          <div class=\"chat-header\">\r\n            <div class=\"chat-user-info\">\r\n              <el-avatar :size=\"40\" :src=\"currentSession?.avatar\" />\r\n              <span class=\"chat-user-name\">{{ currentSession?.name }}</span>\r\n            </div>\r\n            <el-button \r\n              type=\"danger\" \r\n              text \r\n              :icon=\"Delete\" \r\n              @click=\"handleDeleteSession\"\r\n            >\r\n              删除会话\r\n            </el-button>\r\n          </div>\r\n\r\n          <!-- 消息列表 -->\r\n          <el-scrollbar ref=\"messageScrollbar\" class=\"message-list\">\r\n            <div \r\n              v-for=\"msg in messages\" \r\n              :key=\"msg.message_id\"\r\n              :class=\"['message-item', msg.sender_id === currentUserId ? 'message-right' : 'message-left']\"\r\n            >\r\n              <el-avatar \r\n                :size=\"40\" \r\n                :src=\"msg.sender_id === currentUserId ? userInfo.avatar : currentSession?.avatar\" \r\n              />\r\n              <div class=\"message-content\">\r\n                <div class=\"message-info\">\r\n                  <span class=\"sender-name\">\r\n                    {{ msg.sender_id === currentUserId ? '我' : currentSession?.name }}\r\n                  </span>\r\n                  <span class=\"message-time\">{{ formatTime(msg.created_at) }}</span>\r\n                </div>\r\n                <div class=\"message-bubble\">\r\n                  <template v-if=\"msg.message_type === 0\">\r\n                    {{ msg.content }}\r\n                  </template>\r\n                  <template v-else>\r\n                    <el-image \r\n                      :src=\"msg.content\" \r\n                      :preview-src-list=\"[msg.content]\"\r\n                      fit=\"cover\"\r\n                      class=\"message-image\"\r\n                    />\r\n                  </template>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <el-empty v-if=\"messages.length === 0\" description=\"暂无消息\" />\r\n          </el-scrollbar>\r\n\r\n          <!-- 输入区域 -->\r\n          <div class=\"input-area\">\r\n            <div class=\"input-toolbar\">\r\n              <el-upload\r\n                :show-file-list=\"false\"\r\n                :before-upload=\"handleImageUpload\"\r\n                accept=\"image/*\"\r\n              >\r\n                <el-button :icon=\"Picture\" circle />\r\n              </el-upload>\r\n            </div>\r\n            <div class=\"input-box\">\r\n              <el-input\r\n                v-model=\"messageInput\"\r\n                type=\"textarea\"\r\n                :rows=\"3\"\r\n                placeholder=\"输入消息...\"\r\n                @keydown.enter.prevent=\"handleSendMessage\"\r\n              />\r\n              <el-button \r\n                type=\"primary\" \r\n                :icon=\"Promotion\"\r\n                :loading=\"sending\"\r\n                @click=\"handleSendMessage\"\r\n              >\r\n                发送\r\n              </el-button>\r\n            </div>\r\n          </div>\r\n        </template>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, computed, onMounted, nextTick, watch } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { Delete, Picture, Promotion } from '@element-plus/icons-vue'\r\nimport { ElMessage, ElMessageBox } from 'element-plus'\r\nimport {\r\n  getSessionList,\r\n  getMessageList,\r\n  sendMessage,\r\n  markMessagesRead,\r\n  uploadChatImage,\r\n  deleteSession\r\n} from '@/api/chat'\r\n\r\nconst router = useRouter()\r\nconst store = useStore()\r\n\r\nconst sessions = ref([])\r\nconst messages = ref([])\r\nconst currentSessionId = ref(null)\r\nconst messageInput = ref('')\r\nconst sending = ref(false)\r\nconst messageScrollbar = ref(null)\r\n\r\nconst userInfo = computed(() => store.state.userInfo || {})\r\nconst currentUserId = computed(() => userInfo.value.user_id || null)\r\n\r\nconst currentSession = computed(() => {\r\n  if (!currentSessionId.value) return null\r\n  const session = sessions.value.find(s => s.session_id === currentSessionId.value)\r\n  if (!session) return null\r\n  \r\n  return {\r\n    name: getOtherUserName(session),\r\n    avatar: getOtherUserAvatar(session)\r\n  }\r\n})\r\n\r\nconst totalUnread = computed(() => {\r\n  return sessions.value.reduce((sum, session) => sum + (session.unread_count || 0), 0)\r\n})\r\n\r\n// 获取对方用户名\r\nconst getOtherUserName = (session) => {\r\n  const isCurrentUserBuyer = session.buyer_id === currentUserId.value\r\n  // 可以从会话中获取用户信息，或通过API获取\r\n  return isCurrentUserBuyer ? `卖家 #${session.seller_id}` : `买家 #${session.buyer_id}`\r\n}\r\n\r\n// 获取对方用户头像\r\nconst getOtherUserAvatar = (session) => {\r\n  // 可以从会话中获取用户信息，或通过API获取\r\n  return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n}\r\n\r\n// 格式化时间\r\nconst formatTime = (timeStr) => {\r\n  if (!timeStr) return ''\r\n  const date = new Date(timeStr)\r\n  const now = new Date()\r\n  const diff = now - date\r\n  \r\n  if (diff < 60000) return '刚刚'\r\n  if (diff < 3600000) return `${Math.floor(diff / 60000)}分钟前`\r\n  if (diff < 86400000) return `${Math.floor(diff / 3600000)}小时前`\r\n  \r\n  return `${date.getMonth() + 1}-${date.getDate()}`\r\n}\r\n\r\n// 加载会话列表\r\nconst loadSessions = async () => {\r\n  try {\r\n    const res = await getSessionList()\r\n    if (res.code === 200) {\r\n      sessions.value = res.data.list || []\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('加载会话列表失败')\r\n  }\r\n}\r\n\r\n// 选择会话\r\nconst selectSession = async (sessionId) => {\r\n  currentSessionId.value = sessionId\r\n  await loadMessages(sessionId)\r\n  await markRead(sessionId)\r\n}\r\n\r\n// 加载消息列表\r\nconst loadMessages = async (sessionId) => {\r\n  try {\r\n    const res = await getMessageList(sessionId)\r\n    if (res.code === 200) {\r\n      messages.value = res.data.list || []\r\n      await nextTick()\r\n      scrollToBottom()\r\n    } \r\n    else {\r\n      ElMessage.error(res.data.message)\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('加载消息失败')\r\n  }\r\n}\r\n\r\n// 标记为已读\r\nconst markRead = async (sessionId) => {\r\n  try {\r\n    await markMessagesRead(sessionId)\r\n    // 更新会话列表中的未读数\r\n    const session = sessions.value.find(s => s.session_id === sessionId)\r\n    if (session) {\r\n      session.unread_count = 0\r\n    }\r\n  } catch (error) {\r\n    console.error('标记已读失败', error)\r\n  }\r\n}\r\n\r\n// 发送消息\r\nconst handleSendMessage = async () => {\r\n  if (!messageInput.value.trim()) {\r\n    ElMessage.warning('请输入消息内容')\r\n    return\r\n  }\r\n  \r\n  if (!currentSessionId.value) {\r\n    ElMessage.warning('请先选择一个会话')\r\n    return\r\n  }\r\n  \r\n  if (!currentUserId.value) {\r\n    ElMessage.error('用户信息未加载，请刷新页面')\r\n    return\r\n  }\r\n  \r\n  const session = sessions.value.find(s => s.session_id === currentSessionId.value)\r\n  if (!session) return\r\n  \r\n  const receiverId = session.buyer_id === currentUserId.value ? session.seller_id : session.buyer_id\r\n  \r\n  sending.value = true\r\n  try {\r\n    const res = await sendMessage({\r\n      session_id: currentSessionId.value,\r\n      receiver_id: receiverId,\r\n      message_type: 0,\r\n      content: messageInput.value\r\n    })\r\n    \r\n    if (res.code === 200) {\r\n      messages.value.push(res.data)\r\n      messageInput.value = ''\r\n      await nextTick()\r\n      scrollToBottom()\r\n      \r\n      // 更新会话列表\r\n      session.last_message = res.data.content\r\n      session.updated_at = res.data.created_at\r\n      \r\n      // 将当前会话移到最前\r\n      sessions.value = [\r\n        session,\r\n        ...sessions.value.filter(s => s.session_id !== currentSessionId.value)\r\n      ]\r\n    } else {\r\n      ElMessage.error(res.message || '发送失败')\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('发送失败')\r\n  } finally {\r\n    sending.value = false\r\n  }\r\n}\r\n\r\n// 上传图片\r\nconst handleImageUpload = async (file) => {\r\n  const isImage = file.type.startsWith('image/')\r\n  const isLt5M = file.size / 1024 / 1024 < 5\r\n  \r\n  if (!isImage) {\r\n    ElMessage.error('只能上传图片文件!')\r\n    return false\r\n  }\r\n  if (!isLt5M) {\r\n    ElMessage.error('图片大小不能超过 5MB!')\r\n    return false\r\n  }\r\n  \r\n  if (!currentUserId.value) {\r\n    ElMessage.error('用户信息未加载，请刷新页面')\r\n    return false\r\n  }\r\n  \r\n  try {\r\n    const res = await uploadChatImage(file)\r\n    if (res.code === 200) {\r\n      const session = sessions.value.find(s => s.session_id === currentSessionId.value)\r\n      if (!session) {\r\n        ElMessage.error('会话不存在')\r\n        return false\r\n      }\r\n      \r\n      const receiverId = session.buyer_id === currentUserId.value ? session.seller_id : session.buyer_id\r\n      \r\n      const msgRes = await sendMessage({\r\n        session_id: currentSessionId.value,\r\n        receiver_id: receiverId,\r\n        message_type: 1,\r\n        content: res.data.image_url\r\n      })\r\n      \r\n      if (msgRes.code === 200) {\r\n        messages.value.push(msgRes.data)\r\n        await nextTick()\r\n        scrollToBottom()\r\n      }\r\n    } else {\r\n      ElMessage.error(res.message || '上传失败')\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('上传失败')\r\n  }\r\n  \r\n  return false\r\n}\r\n\r\n// 删除会话\r\nconst handleDeleteSession = () => {\r\n  ElMessageBox.confirm('确定删除此会话吗？删除后消息记录将无法恢复。', '提示', {\r\n    confirmButtonText: '确定',\r\n    cancelButtonText: '取消',\r\n    type: 'warning'\r\n  }).then(async () => {\r\n    try {\r\n      const res = await deleteSession(currentSessionId.value)\r\n      if (res.code === 200) {\r\n        ElMessage.success('删除成功')\r\n        sessions.value = sessions.value.filter(s => s.session_id !== currentSessionId.value)\r\n        currentSessionId.value = null\r\n        messages.value = []\r\n      } else {\r\n        ElMessage.error(res.message || '删除失败')\r\n      }\r\n    } catch (error) {\r\n      ElMessage.error('删除失败')\r\n    }\r\n  }).catch(() => {})\r\n}\r\n\r\n// 滚动到底部\r\nconst scrollToBottom = () => {\r\n  if (messageScrollbar.value) {\r\n    //const scrollElement = messageScrollbar.value.$refs.wrap\r\n    scrollElement.scrollTop = scrollElement.scrollHeight\r\n  }\r\n}\r\n\r\nonMounted(async () => {\r\n  // 确保用户信息已加载\r\n  if (!store.state.userInfo || !store.state.userInfo.user_id) {\r\n    try {\r\n      await store.dispatch('fetchUserInfo')\r\n    } catch (error) {\r\n      ElMessage.error('获取用户信息失败')\r\n      router.push('/login')\r\n      return\r\n    }\r\n  }\r\n  \r\n  loadSessions()\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.chat-container {\r\n  height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.cha
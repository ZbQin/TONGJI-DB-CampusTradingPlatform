{"ast":null,"code":"import { ref, onMounted, reactive } from 'vue';\nimport { getUserInfo, updateProfile, changePassword, uploadAvatar } from '@/api/auth';\nimport { ElMessage } from 'element-plus';\nimport { Plus } from '@element-plus/icons-vue';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  __name: 'Profile',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const activeTab = ref('info');\n    const userInfo = ref({\n      username: '',\n      nickname: '',\n      bio: '',\n      campus: '',\n      dormitory: '',\n      avatar: ''\n    });\n    const passwordForm = reactive({\n      old_password: '',\n      new_password: '',\n      confirm_password: ''\n    });\n    const passwordFormRef = ref(null);\n    const passwordRules = {\n      old_password: [{\n        required: true,\n        message: '请输入原密码',\n        trigger: 'blur'\n      }],\n      new_password: [{\n        required: true,\n        message: '请输入新密码',\n        trigger: 'blur'\n      }],\n      confirm_password: [{\n        required: true,\n        message: '请确认新密码',\n        trigger: 'blur'\n      }, {\n        validator: (rule, value, callback) => {\n          if (value !== passwordForm.new_password) {\n            callback(new Error('两次输入密码不一致'));\n          } else {\n            callback();\n          }\n        },\n        trigger: 'blur'\n      }]\n    };\n\n    // 获取用户信息\n    const fetchUserInfo = async () => {\n      try {\n        const res = await getUserInfo();\n        if (res.code === 200) {\n          userInfo.value = res.data;\n          // 处理头像URL，如果是相对路径，可能需要拼接后端地址\n          // 这里假设后端返回的是 /static/... 这样的路径\n          // 如果前端和后端在不同端口，可能需要拼接 baseURL\n          // 暂时直接使用，假设配置了代理或者已经是完整URL\n        }\n      } catch (error) {\n        console.error(error);\n      }\n    };\n\n    // 更新个人信息\n    const handleUpdateProfile = async () => {\n      try {\n        const res = await updateProfile(userInfo.value);\n        if (res.code === 200) {\n          ElMessage.success('更新成功');\n          fetchUserInfo();\n        } else {\n          ElMessage.error(res.message);\n        }\n      } catch (error) {\n        console.error(error);\n      }\n    };\n\n    // 修改密码\n    const handleChangePassword = async () => {\n      if (!passwordFormRef.value) return;\n      await passwordFormRef.value.validate(async valid => {\n        if (valid) {\n          try {\n            const res = await changePassword(passwordForm);\n            if (res.code === 200) {\n              ElMessage.success('密码修改成功');\n              passwordForm.old_password = '';\n              passwordForm.new_password = '';\n              passwordForm.confirm_password = '';\n            } else {\n              ElMessage.error(res.message);\n            }\n          } catch (error) {\n            console.error(error);\n          }\n        }\n      });\n    };\n\n    // 头像上传前校验\n    const beforeAvatarUpload = rawFile => {\n      const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];\n      if (!allowedTypes.includes(rawFile.type)) {\n        ElMessage.error('头像图片只能是 JPG/PNG/GIF 格式!');\n        return false;\n      } else if (rawFile.size / 1024 / 1024 > 2) {\n        ElMessage.error('头像图片大小不能超过 2MB!');\n        return false;\n      }\n      return true;\n    };\n\n    // 自定义上传头像\n    const handleAvatarUpload = async options => {\n      const formData = new FormData();\n      formData.append('file', options.file);\n      try {\n        const res = await uploadAvatar(formData);\n        if (res.code === 200) {\n          ElMessage.success('头像上传成功');\n          userInfo.value.avatar = res.data.avatar_url;\n        } else {\n          ElMessage.error(res.message);\n        }\n      } catch (error) {\n        console.error(error);\n        ElMessage.error('上传失败');\n      }\n    };\n    onMounted(() => {\n      fetchUserInfo();\n    });\n    const __returned__ = {\n      activeTab,\n      userInfo,\n      passwordForm,\n      passwordFormRef,\n      passwordRules,\n      fetchUserInfo,\n      handleUpdateProfile,\n      handleChangePassword,\n      beforeAvatarUpload,\n      handleAvatarUpload,\n      ref,\n      onMounted,\n      reactive,\n      get getUserInfo() {\n        return getUserInfo;\n      },\n      get updateProfile() {\n        return updateProfile;\n      },\n      get changePassword() {\n        return changePassword;\n      },\n      get uploadAvatar() {\n        return uploadAvatar;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get Plus() {\n        return Plus;\n      },\n      NavBar\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","reactive","getUserInfo","updateProfile","changePassword","uploadAvatar","ElMessage","Plus","NavBar","activeTab","userInfo","username","nickname","bio","campus","dormitory","avatar","passwordForm","old_password","new_password","confirm_password","passwordFormRef","passwordRules","required","message","trigger","validator","rule","value","callback","Error","fetchUserInfo","res","code","data","error","console","handleUpdateProfile","success","handleChangePassword","validate","valid","beforeAvatarUpload","rawFile","allowedTypes","includes","type","size","handleAvatarUpload","options","formData","FormData","append","file","avatar_url"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/Profile.vue"],"sourcesContent":["<template>\r\n  <div class=\"profile-container\">\r\n    <NavBar />\r\n    <div class=\"page-shell\">\r\n      <div class=\"hero-shell profile-hero\">\r\n        <div>\r\n          <div class=\"floating-badge\">完善资料 · 信任加分</div>\r\n          <h2>你的校园名片</h2>\r\n          <p class=\"section-sub\">更新头像、昵称和校区信息，让同学更快信任你</p>\r\n        </div>\r\n        <el-button class=\"ghost-button\" @click=\"$router.back()\">返回</el-button>\r\n      </div>\r\n\r\n      <el-card class=\"box-card soft-card glass\">\r\n      <template #header>\r\n        <div class=\"card-header\">\r\n          <span>个人中心</span>\r\n        </div>\r\n      </template>\r\n      \r\n      <el-tabs v-model=\"activeTab\">\r\n        <!-- 基本信息 -->\r\n        <el-tab-pane label=\"基本信息\" name=\"info\">\r\n          <div class=\"user-info-form\">\r\n            <el-form :model=\"userInfo\" label-width=\"100px\">\r\n              <el-form-item label=\"头像\">\r\n                <el-upload\r\n                  class=\"avatar-uploader\"\r\n                  action=\"\"\r\n                  :show-file-list=\"false\"\r\n                  :http-request=\"handleAvatarUpload\"\r\n                  :before-upload=\"beforeAvatarUpload\"\r\n                >\r\n                  <img v-if=\"userInfo.avatar\" :src=\"userInfo.avatar\" class=\"avatar\" />\r\n                  <el-icon v-else class=\"avatar-uploader-icon\"><Plus /></el-icon>\r\n                </el-upload>\r\n              </el-form-item>\r\n              \r\n              <el-form-item label=\"用户名\">\r\n                <el-input v-model=\"userInfo.username\" disabled></el-input>\r\n              </el-form-item>\r\n              \r\n              <el-form-item label=\"昵称\">\r\n                <el-input v-model=\"userInfo.nickname\"></el-input>\r\n              </el-form-item>\r\n              \r\n              <el-form-item label=\"个人简介\">\r\n                <el-input type=\"textarea\" v-model=\"userInfo.bio\"></el-input>\r\n              </el-form-item>\r\n              \r\n              <el-form-item label=\"校区\">\r\n                <el-select v-model=\"userInfo.campus\" placeholder=\"请选择校区\">\r\n                  <el-option label=\"四平路校区\" value=\"四平路校区\"></el-option>\r\n                  <el-option label=\"嘉定校区\" value=\"嘉定校区\"></el-option>\r\n                  <el-option label=\"沪西校区\" value=\"沪西校区\"></el-option>\r\n                  <el-option label=\"彰武校区\" value=\"彰武校区\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n              \r\n              <el-form-item label=\"宿舍楼\">\r\n                <el-input v-model=\"userInfo.dormitory\"></el-input>\r\n              </el-form-item>\r\n              \r\n              <el-form-item>\r\n                <el-button type=\"primary\" @click=\"handleUpdateProfile\">保存修改</el-button>\r\n              </el-form-item>\r\n            </el-form>\r\n          </div>\r\n        </el-tab-pane>\r\n        \r\n        <!-- 修改密码 -->\r\n        <el-tab-pane label=\"修改密码\" name=\"password\">\r\n          <el-form :model=\"passwordForm\" :rules=\"passwordRules\" ref=\"passwordFormRef\" label-width=\"100px\">\r\n            <el-form-item label=\"原密码\" prop=\"old_password\">\r\n              <el-input type=\"password\" v-model=\"passwordForm.old_password\" show-password></el-input>\r\n            </el-form-item>\r\n            \r\n            <el-form-item label=\"新密码\" prop=\"new_password\">\r\n              <el-input type=\"password\" v-model=\"passwordForm.new_password\" show-password></el-input>\r\n            </el-form-item>\r\n            \r\n            <el-form-item label=\"确认新密码\" prop=\"confirm_password\">\r\n              <el-input type=\"password\" v-model=\"passwordForm.confirm_password\" show-password></el-input>\r\n            </el-form-item>\r\n            \r\n            <el-form-item>\r\n              <el-button type=\"primary\" @click=\"handleChangePassword\">修改密码</el-button>\r\n            </el-form-item>\r\n          </el-form>\r\n        </el-tab-pane>\r\n      </el-tabs>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted, reactive } from 'vue'\r\nimport { getUserInfo, updateProfile, changePassword, uploadAvatar } from '@/api/auth'\r\nimport { ElMessage } from 'element-plus'\r\nimport { Plus } from '@element-plus/icons-vue'\r\nimport NavBar from '@/components/NavBar.vue'\r\n\r\nconst activeTab = ref('info')\r\nconst userInfo = ref({\r\n  username: '',\r\n  nickname: '',\r\n  bio: '',\r\n  campus: '',\r\n  dormitory: '',\r\n  avatar: ''\r\n})\r\n\r\nconst passwordForm = reactive({\r\n  old_password: '',\r\n  new_password: '',\r\n  confirm_password: ''\r\n})\r\n\r\nconst passwordFormRef = ref(null)\r\n\r\nconst passwordRules = {\r\n  old_password: [{ required: true, message: '请输入原密码', trigger: 'blur' }],\r\n  new_password: [{ required: true, message: '请输入新密码', trigger: 'blur' }],\r\n  confirm_password: [\r\n    { required: true, message: '请确认新密码', trigger: 'blur' },\r\n    {\r\n      validator: (rule, value, callback) => {\r\n        if (value !== passwordForm.new_password) {\r\n          callback(new Error('两次输入密码不一致'))\r\n        } else {\r\n          callback()\r\n        }\r\n      },\r\n      trigger: 'blur'\r\n    }\r\n  ]\r\n}\r\n\r\n// 获取用户信息\r\nconst fetchUserInfo = async () => {\r\n  try {\r\n    const res = await getUserInfo()\r\n    if (res.code === 200) {\r\n      userInfo.value = res.data\r\n      // 处理头像URL，如果是相对路径，可能需要拼接后端地址\r\n      // 这里假设后端返回的是 /static/... 这样的路径\r\n      // 如果前端和后端在不同端口，可能需要拼接 baseURL\r\n      // 暂时直接使用，假设配置了代理或者已经是完整URL\r\n    }\r\n  } catch (error) {\r\n    console.error(error)\r\n  }\r\n}\r\n\r\n// 更新个人信息\r\nconst handleUpdateProfile = async () => {\r\n  try {\r\n    const res = await updateProfile(userInfo.value)\r\n    if (res.code === 200) {\r\n      ElMessage.success('更新成功')\r\n      fetchUserInfo()\r\n    } else {\r\n      ElMessage.error(res.message)\r\n    }\r\n  } catch (error) {\r\n    console.error(error)\r\n  }\r\n}\r\n\r\n// 修改密码\r\nconst handleChangePassword = async () => {\r\n  if (!passwordFormRef.value) return\r\n  \r\n  await passwordFormRef.value.validate(async (valid) => {\r\n    if (valid) {\r\n      try {\r\n        const res = await changePassword(passwordForm)\r\n        if (res.code === 200) {\r\n          ElMessage.success('密码修改成功')\r\n          passwordForm.old_password = ''\r\n          passwordForm.new_password = ''\r\n          passwordForm.confirm_password = ''\r\n        } else {\r\n          ElMessage.error(res.message)\r\n        }\r\n      } catch (error) {\r\n        console.error(error)\r\n      }\r\n    }\r\n  })\r\n}\r\n\r\n// 头像上传前校验\r\nconst beforeAvatarUpload = (rawFile) => {\r\n  const allowedTypes = ['image/jpeg', 'image/png', 'image/gif']\r\n  if (!allowedTypes.includes(rawFile.type)) {\r\n    ElMessage.error('头像图片只能是 JPG/PNG/GIF 格式!')\r\n    return false\r\n  } else if (rawFile.size / 1024 / 1024 > 2) {\r\n    ElMessage.error('头像图片大小不能超过 2MB!')\r\n    return false\r\n  }\r\n  return true\r\n}\r\n\r\n// 自定义上传头像\r\nconst handleAvatarUpload = async (options) => {\r\n  const formData = new FormData()\r\n  formData.append('file', options.file)\r\n  \r\n  try {\r\n    const res = await uploadAvatar(formData)\r\n    if (res.code === 200) {\r\n      ElMessage.success('头像上传成功')\r\n      userInfo.value.avatar = res.data.avatar_url\r\n    } else {\r\n      ElMessage.error(res.message)\r\n    }\r\n  } catch (error) {\r\n    console.error(error)\r\n    ElMessage.error('上传失败')\r\n  }\r\n}\r\n\r\nonMounted(() => {\r\n  fetchUserInfo()\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.profile-container {\r\n  min-height: 100vh;\r\n  background: var(--bg-page);\r\n}\r\n\r\n.page-shell {\r\n  max-width: 880px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.profile-hero {\r\n  margin-bottom: 16px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.avatar-uploader .avatar {\r\n  width: 100px;\r\n  height: 100px;\r\n  display: block;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.avatar-uploader .el-upload {\r\n  border: 1px dashed var(--el-border-color);\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n  transition: var(--el-transition-duration-fast);\r\n}\r\n\r\n.avatar-uploader .el-upload:hover {\r\n  border-color: var(--el-color-primary);\r\n}\r\n\r\n.el-icon.avatar-uploader-icon {\r\n  font-size: 28px;\r\n  color: #8c939d;\r\n  width: 100px;\r\n  height: 100px;\r\n  text-align: center;\r\n  border: 1px dashed #d9d9d9;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n</style>"],"mappings":"AAiGA,SAASA,GAAG,EAAEC,SAAS,EAAEC,QAAQ,QAAQ,KAAK;AAC9C,SAASC,WAAW,EAAEC,aAAa,EAAEC,cAAc,EAAEC,YAAY,QAAQ,YAAY;AACrF,SAASC,SAAS,QAAQ,cAAc;AACxC,SAASC,IAAI,QAAQ,yBAAyB;AAC9C,OAAOC,MAAM,MAAM,yBAAyB;;;;;;;IAE5C,MAAMC,SAAS,GAAGV,GAAG,CAAC,MAAM,CAAC;IAC7B,MAAMW,QAAQ,GAAGX,GAAG,CAAC;MACnBY,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE,EAAE;MACZC,GAAG,EAAE,EAAE;MACPC,MAAM,EAAE,EAAE;MACVC,SAAS,EAAE,EAAE;MACbC,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,YAAY,GAAGhB,QAAQ,CAAC;MAC5BiB,YAAY,EAAE,EAAE;MAChBC,YAAY,EAAE,EAAE;MAChBC,gBAAgB,EAAE;IACpB,CAAC,CAAC;IAEF,MAAMC,eAAe,GAAGtB,GAAG,CAAC,IAAI,CAAC;IAEjC,MAAMuB,aAAa,GAAG;MACpBJ,YAAY,EAAE,CAAC;QAAEK,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MACtEN,YAAY,EAAE,CAAC;QAAEI,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MACtEL,gBAAgB,EAAE,CAChB;QAAEG,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAO,CAAC,EACtD;QACEC,SAAS,EAAEA,CAACC,IAAI,EAAEC,KAAK,EAAEC,QAAQ,KAAK;UACpC,IAAID,KAAK,KAAKX,YAAY,CAACE,YAAY,EAAE;YACvCU,QAAQ,CAAC,IAAIC,KAAK,CAAC,WAAW,CAAC,CAAC;UAClC,CAAC,MAAM;YACLD,QAAQ,CAAC,CAAC;UACZ;QACF,CAAC;QACDJ,OAAO,EAAE;MACX,CAAC;IAEL,CAAC;;IAED;IACA,MAAMM,aAAa,GAAG,MAAAA,CAAA,KAAY;MAChC,IAAI;QACF,MAAMC,GAAG,GAAG,MAAM9B,WAAW,CAAC,CAAC;QAC/B,IAAI8B,GAAG,CAACC,IAAI,KAAK,GAAG,EAAE;UACpBvB,QAAQ,CAACkB,KAAK,GAAGI,GAAG,CAACE,IAAI;UACzB;UACA;UACA;UACA;QACF;MACF,CAAC,CAAC,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAACA,KAAK,CAAC;MACtB;IACF,CAAC;;IAED;IACA,MAAME,mBAAmB,GAAG,MAAAA,CAAA,KAAY;MACtC,IAAI;QACF,MAAML,GAAG,GAAG,MAAM7B,aAAa,CAACO,QAAQ,CAACkB,KAAK,CAAC;QAC/C,IAAII,GAAG,CAACC,IAAI,KAAK,GAAG,EAAE;UACpB3B,SAAS,CAACgC,OAAO,CAAC,MAAM,CAAC;UACzBP,aAAa,CAAC,CAAC;QACjB,CAAC,MAAM;UACLzB,SAAS,CAAC6B,KAAK,CAACH,GAAG,CAACR,OAAO,CAAC;QAC9B;MACF,CAAC,C
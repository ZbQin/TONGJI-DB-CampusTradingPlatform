{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport { ref, reactive } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport { login, sendVerificationCode, resetPassword } from '@/api/auth';\nexport default {\n  name: 'Login',\n  setup() {\n    const router = useRouter();\n    const loading = ref(false);\n    const loginType = ref('password');\n    const rememberMe = ref(false);\n    const showResetDialog = ref(false);\n    const countdown = ref(0);\n    const resetCountdown = ref(0);\n\n    // 密码登录表单\n    const passwordFormRef = ref(null);\n    const passwordForm = reactive({\n      account: '',\n      password: '',\n      login_type: 'password'\n    });\n    const validateAccount = (rule, value, callback) => {\n      if (!value) {\n        callback(new Error('请输入用户名/手机号/邮箱'));\n      } else {\n        callback();\n      }\n    };\n    const passwordRules = {\n      account: [{\n        required: true,\n        validator: validateAccount,\n        trigger: 'blur'\n      }],\n      password: [{\n        required: true,\n        message: '请输入密码',\n        trigger: 'blur'\n      }, {\n        min: 6,\n        max: 20,\n        message: '密码长度为6-20个字符',\n        trigger: 'blur'\n      }]\n    };\n\n    // 短信登录表单\n    const smsFormRef = ref(null);\n    const smsForm = reactive({\n      account: '',\n      login_type: 'sms',\n      verification_code: ''\n    });\n    const validatePhone = (rule, value, callback) => {\n      const phoneReg = /^1[3-9]\\d{9}$/;\n      if (!value) {\n        callback(new Error('请输入手机号'));\n      } else if (!phoneReg.test(value)) {\n        callback(new Error('手机号格式不正确'));\n      } else {\n        callback();\n      }\n    };\n    const smsRules = {\n      phone: [{\n        required: true,\n        validator: validatePhone,\n        trigger: 'blur'\n      }],\n      verification_code: [{\n        required: true,\n        message: '请输入验证码',\n        trigger: 'blur'\n      }, {\n        len: 6,\n        message: '验证码为6位数字',\n        trigger: 'blur'\n      }]\n    };\n\n    // 重置密码表单\n    const resetFormRef = ref(null);\n    const resetForm = reactive({\n      phone: '',\n      verification_code: '',\n      new_password: '',\n      confirm_password: ''\n    });\n    const validateConfirmPassword = (rule, value, callback) => {\n      if (!value) {\n        callback(new Error('请再次输入密码'));\n      } else if (value !== resetForm.new_password) {\n        callback(new Error('两次输入密码不一致'));\n      } else {\n        callback();\n      }\n    };\n    const resetRules = {\n      phone: [{\n        required: true,\n        validator: validatePhone,\n        trigger: 'blur'\n      }],\n      verification_code: [{\n        required: true,\n        message: '请输入验证码',\n        trigger: 'blur'\n      }, {\n        len: 6,\n        message: '验证码为6位数字',\n        trigger: 'blur'\n      }],\n      new_password: [{\n        required: true,\n        message: '请输入新密码',\n        trigger: 'blur'\n      }, {\n        min: 6,\n        max: 20,\n        message: '密码长度为6-20个字符',\n        trigger: 'blur'\n      }],\n      confirm_password: [{\n        required: true,\n        validator: validateConfirmPassword,\n        trigger: 'blur'\n      }]\n    };\n\n    // 密码登录\n    const handlePasswordLogin = () => {\n      passwordFormRef.value.validate(async valid => {\n        if (valid) {\n          loading.value = true;\n          try {\n            const response = await login(passwordForm);\n            if (response.code === 200) {\n              // 保存token和用户信息\n              localStorage.setItem('token', response.data.token);\n              localStorage.setItem('userInfo', JSON.stringify(response.data.user_info));\n              ElMessage.success('登录成功');\n              router.push('/');\n            } else {\n              ElMessage.error(response.message);\n            }\n          } catch (error) {\n            ElMessage.error('登录失败，请稍后重试');\n          } finally {\n            loading.value = false;\n          }\n        }\n      });\n    };\n\n    // 短信登录\n    const handleSmsLogin = () => {\n      smsFormRef.value.validate(async valid => {\n        if (valid) {\n          loading.value = true;\n          try {\n            smsForm.account = smsForm.phone;\n            const response = await login(smsForm);\n            if (response.code === 200) {\n              localStorage.setItem('token', response.data.token);\n              localStorage.setItem('userInfo', JSON.stringify(response.data.user_info));\n              ElMessage.success('登录成功');\n              router.push('/');\n            } else {\n              ElMessage.error(response.message);\n            }\n          } catch (error) {\n            ElMessage.error('登录失败，请稍后重试');\n          } finally {\n            loading.value = false;\n          }\n        }\n      });\n    };\n\n    // 发送验证码\n    const sendCode = async type => {\n      const phone = type === 'reset' ? resetForm.phone : smsForm.phone;\n      const phoneReg = /^1[3-9]\\d{9}$/;\n      if (!phone) {\n        ElMessage.warning('请输入手机号');\n        return;\n      }\n      if (!phoneReg.test(phone)) {\n        ElMessage.warning('手机号格式不正确');\n        return;\n      }\n      try {\n        const response = await sendVerificationCode({\n          phone,\n          type: type === 'reset' ? 'reset' : 'login'\n        });\n        if (response.code === 200) {\n          ElMessage.success('验证码已发送');\n\n          // 开始倒计时\n          const countdownRef = type === 'reset' ? resetCountdown : countdown;\n          countdownRef.value = 60;\n          const timer = setInterval(() => {\n            countdownRef.value--;\n            if (countdownRef.value <= 0) {\n              clearInterval(timer);\n            }\n          }, 1000);\n        } else {\n          ElMessage.error(response.message);\n        }\n      } catch (error) {\n        ElMessage.error('发送失败，请稍后重试');\n      }\n    };\n\n    // 重置密码\n    const handleResetPassword = () => {\n      resetFormRef.value.validate(async valid => {\n        if (valid) {\n          loading.value = true;\n          try {\n            const response = await resetPassword(resetForm);\n            if (response.code === 200) {\n              ElMessage.success('密码重置成功');\n              showResetDialog.value = false;\n              // 清空表单\n              resetFormRef.value.resetFields();\n            } else {\n              ElMessage.error(response.message);\n            }\n          } catch (error) {\n            ElMessage.error('重置失败，请稍后重试');\n          } finally {\n            loading.value = false;\n          }\n        }\n      });\n    };\n    return {\n      loading,\n      loginType,\n      rememberMe,\n      showResetDialog,\n      countdown,\n      resetCountdown,\n      passwordFormRef,\n      passwordForm,\n      passwordRules,\n      smsFormRef,\n      smsForm,\n      smsRules,\n      resetFormRef,\n      resetForm,\n      resetRules,\n      handlePasswordLogin,\n      handleSmsLogin,\n      sendCode,\n      handleResetPassword\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","useRouter","ElMessage","login","sendVerificationCode","resetPassword","name","setup","router","loading","loginType","rememberMe","showResetDialog","countdown","resetCountdown","passwordFormRef","passwordForm","account","password","login_type","validateAccount","rule","value","callback","Error","passwordRules","required","validator","trigger","message","min","max","smsFormRef","smsForm","verification_code","validatePhone","phoneReg","test","smsRules","phone","len","resetFormRef","resetForm","new_password","confirm_password","validateConfirmPassword","resetRules","handlePasswordLogin","validate","valid","response","code","localStorage","setItem","data","token","JSON","stringify","user_info","success","push","error","handleSmsLogin","sendCode","type","warning","countdownRef","timer","setInterval","clearInterval","handleResetPassword","resetFields"],"sources":["D:\\VsCodeProject\\CampusTradingPlatform\\frontend\\src\\views\\Login.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <div class=\"login-box\">\r\n      <h2 class=\"login-title\">校园交易平台</h2>\r\n      \r\n      <!-- 登录方式切换 -->\r\n      <div class=\"login-tabs\">\r\n        <div \r\n          :class=\"['tab-item', { active: loginType === 'password' }]\"\r\n          @click=\"loginType = 'password'\"\r\n        >\r\n          密码登录\r\n        </div>\r\n        <div \r\n          :class=\"['tab-item', { active: loginType === 'sms' }]\"\r\n          @click=\"loginType = 'sms'\"\r\n        >\r\n          短信登录\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 密码登录表单 -->\r\n      <el-form \r\n        v-if=\"loginType === 'password'\"\r\n        ref=\"passwordFormRef\" \r\n        :model=\"passwordForm\" \r\n        :rules=\"passwordRules\"\r\n        class=\"login-form\"\r\n      >\r\n        <el-form-item prop=\"account\">\r\n          <el-input\r\n            v-model=\"passwordForm.account\"\r\n            placeholder=\"请输入用户名/手机号/邮箱\"\r\n            prefix-icon=\"el-icon-user\"\r\n            size=\"large\"\r\n          />\r\n        </el-form-item>\r\n        \r\n        <el-form-item prop=\"password\">\r\n          <el-input\r\n            v-model=\"passwordForm.password\"\r\n            type=\"password\"\r\n            placeholder=\"请输入密码\"\r\n            prefix-icon=\"el-icon-lock\"\r\n            size=\"large\"\r\n            show-password\r\n            @keyup.enter=\"handlePasswordLogin\"\r\n          />\r\n        </el-form-item>\r\n\r\n        <div class=\"form-footer\">\r\n          <el-checkbox v-model=\"rememberMe\">记住我</el-checkbox>\r\n          <a href=\"#\" class=\"forgot-password\" @click.prevent=\"showResetDialog = true\">忘记密码？</a>\r\n        </div>\r\n\r\n        <el-button \r\n          type=\"primary\" \r\n          size=\"large\" \r\n          class=\"login-button\"\r\n          :loading=\"loading\"\r\n          @click=\"handlePasswordLogin\"\r\n        >\r\n          登录\r\n        </el-button>\r\n      </el-form>\r\n\r\n      <!-- 短信登录表单 -->\r\n      <el-form \r\n        v-else\r\n        ref=\"smsFormRef\" \r\n        :model=\"smsForm\" \r\n        :rules=\"smsRules\"\r\n        class=\"login-form\"\r\n      >\r\n        <el-form-item prop=\"phone\">\r\n          <el-input\r\n            v-model=\"smsForm.phone\"\r\n            placeholder=\"请输入手机号\"\r\n            prefix-icon=\"el-icon-phone\"\r\n            size=\"large\"\r\n            maxlength=\"11\"\r\n          />\r\n        </el-form-item>\r\n        \r\n        <el-form-item prop=\"verification_code\">\r\n          <div class=\"code-input-wrapper\">\r\n            <el-input\r\n              v-model=\"smsForm.verification_code\"\r\n              placeholder=\"请输入验证码\"\r\n              prefix-icon=\"el-icon-message\"\r\n              size=\"large\"\r\n              maxlength=\"6\"\r\n              @keyup.enter=\"handleSmsLogin\"\r\n            />\r\n            <el-button \r\n              class=\"send-code-btn\"\r\n              :disabled=\"countdown > 0\"\r\n              @click=\"sendCode('login')\"\r\n            >\r\n              {{ countdown > 0 ? `${countdown}秒后重试` : '发送验证码' }}\r\n            </el-button>\r\n          </div>\r\n        </el-form-item>\r\n\r\n        <el-button \r\n          type=\"primary\" \r\n          size=\"large\" \r\n          class=\"login-button\"\r\n          :loading=\"loading\"\r\n          @click=\"handleSmsLogin\"\r\n        >\r\n          登录\r\n        </el-button>\r\n      </el-form>\r\n\r\n      <!-- 注册链接 -->\r\n      <div class=\"register-link\">\r\n        还没有账号？\r\n        <router-link to=\"/register\">立即注册</router-link>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 重置密码对话框 -->\r\n    <el-dialog \r\n      title=\"重置密码\" \r\n      v-model=\"showResetDialog\"\r\n      width=\"400px\"\r\n    >\r\n      <el-form \r\n        ref=\"resetFormRef\" \r\n        :model=\"resetForm\" \r\n        :rules=\"resetRules\"\r\n      >\r\n        <el-form-item prop=\"phone\">\r\n          <el-input\r\n            v-model=\"resetForm.phone\"\r\n            placeholder=\"请输入手机号\"\r\n            prefix-icon=\"el-icon-phone\"\r\n            maxlength=\"11\"\r\n          />\r\n        </el-form-item>\r\n        \r\n        <el-form-item prop=\"verification_code\">\r\n          <div class=\"code-input-wrapper\">\r\n            <el-input\r\n              v-model=\"resetForm.verification_code\"\r\n              placeholder=\"请输入验证码\"\r\n              prefix-icon=\"el-icon-message\"\r\n              maxlength=\"6\"\r\n            />\r\n            <el-button \r\n              class=\"send-code-btn\"\r\n              :disabled=\"resetCountdown > 0\"\r\n              @click=\"sendCode('reset')\"\r\n            >\r\n              {{ resetCountdown > 0 ? `${resetCountdown}秒后重试` : '发送验证码' }}\r\n            </el-button>\r\n          </div>\r\n        </el-form-item>\r\n\r\n        <el-form-item prop=\"new_password\">\r\n          <el-input\r\n            v-model=\"resetForm.new_password\"\r\n            type=\"password\"\r\n            placeholder=\"请输入新密码\"\r\n            prefix-icon=\"el-icon-lock\"\r\n            show-password\r\n          />\r\n        </el-form-item>\r\n\r\n        <el-form-item prop=\"confirm_password\">\r\n          <el-input\r\n            v-model=\"resetForm.confirm_password\"\r\n            type=\"password\"\r\n            placeholder=\"请确认新密码\"\r\n            prefix-icon=\"el-icon-lock\"\r\n            show-password\r\n          />\r\n        </el-form-item>\r\n      </el-form>\r\n      \r\n      <template #footer>\r\n        <el-button @click=\"showResetDialog = false\">取消</el-button>\r\n        <el-button type=\"primary\" :loading=\"loading\" @click=\"handleResetPassword\">确定</el-button>\r\n      </template>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport { login, sendVerificationCode, resetPassword } from '@/api/auth'\r\n\r\nexport default {\r\n  name: 'Login',\r\n  setup() {\r\n    const router = useRouter()\r\n    const loading = ref(false)\r\n    const loginType = ref('password')\r\n    const rememberMe = ref(false)\r\n    const showResetDialog = ref(false)\r\n    const countdown = ref(0)\r\n    const resetCountdown = ref(0)\r\n\r\n    // 密码登录表单\r\n    const passwordFormRef = ref(null)\r\n    const passwordForm = reactive({\r\n      account: '',\r\n      password: '',\r\n      login_type: 'password'\r\n    })\r\n\r\n    const validateAccount = (rule, value, callback) => {\r\n      if (!value) {\r\n        callback(new Error('请输入用户名/手机号/邮箱'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n\r\n    const passwordRules = {\r\n      account: [{ required: true, validator: validateAccount, trigger: 'blur' }],\r\n      password: [\r\n        { required: true, message: '请输入密码', trigger: 'blur' },\r\n        { min: 6, max: 20, message: '密码长度为6-20个字符', trigger: 'blur' }\r\n      ]\r\n    }\r\n\r\n    // 短信登录表单\r\n    const smsFormRef = ref(null)\r\n    const smsForm = reactive({\r\n      account: '',\r\n      login_type: 'sms',\r\n      verification_code: ''\r\n    })\r\n\r\n    const validatePhone = (rule, value, callback) => {\r\n      const phoneReg = /^1[3-9]\\d{9}$/\r\n      if (!value) {\r\n        callback(new Error('请输入手机号'))\r\n      } else if (!phoneReg.test(value)) {\r\n        callback(new Error('手机号格式不正确'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n\r\n    const smsRules = {\r\n      phone: [{ required: true, validator: validatePhone, trigger: 'blur' }],\r\n      verification_code: [\r\n        { required: true, message: '请输入验证码', trigger: 'blur' },\r\n        { len: 6, message: '验证码为6位数字', trigger: 'blur' }\r\n      ]\r\n    }\r\n\r\n    // 重置密码表单\r\n    const resetFormRef = ref(null)\r\n    const resetForm = reactive({\r\n      phone: '',\r\n      verification_code: '',\r\n      new_password: '',\r\n      confirm_password: ''\r\n    })\r\n\r\n    const validateConfirmPassword = (rule, value, callback) => {\r\n      if (!value) {\r\n        callback(new Error('请再次输入密码'))\r\n      } else if (value !== resetForm.new_password) {\r\n        callback(new Error('两次输入密码不一致'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n\r\n    const resetRules = {\r\n      phone: [{ required: true, validator: validatePhone, trigger: 'blur' }],\r\n      verification_code: [\r\n        { required: true, message: '请输入验证码', trigger: 'blur' },\r\n        { len: 6, message: '验证码为6位数字', trigger: 'blur' }\r\n      ],\r\n      new_password: [\r\n        { required: true, message: '请输入新密码', trigger: 'blur' },\r\n        { min: 6, max: 20, message: '密码长度为6-20个字符', trigger: 'blur' }\r\n      ],\r\n      confirm_password: [\r\n        { required: true, validator: validateConfirmPassword, trigger: 'blur' }\r\n      ]\r\n    }\r\n\r\n    // 密码登录\r\n    const handlePasswordLogin = () => {\r\n      passwordFormRef.value.validate(async (valid) => {\r\n        if (valid) {\r\n          loading.value = true\r\n          try {\r\n            const response = await login(passwordForm)\r\n            if (response.code === 200) {\r\n              // 保存token和用户信息\r\n              localStorage.setItem('token', response.data.token)\r\n              localStorage.setItem('userInfo', JSON.stringify(response.data.user_info))\r\n              \r\n              ElMessage.success('登录成功')\r\n              router.push('/')\r\n            } else {\r\n              ElMessage.error(response.message)\r\n            }\r\n          } catch (error) {\r\n            ElMessage.error('登录失败，请稍后重试')\r\n          } finally {\r\n            loading.value = false\r\n          }\r\n        }\r\n      })\r\n    }\r\n\r\n    // 短信登录\r\n    const handleSmsLogin = () => {\r\n      smsFormRef.value.validate(async (valid) => {\r\n        if (valid) {\r\n          loading.value = true\r\n          try {\r\n            smsForm.account = smsForm.phone\r\n            const response = await login(smsForm)\r\n            if (response.code === 200) {\r\n              localStorage.setItem('token', response.data.token)\r\n              localStorage.setItem('userInfo', JSON.stringify(response.data.user_info))\r\n              \r\n              ElMessage.success('登录成功')\r\n              router.push('/')\r\n            } else {\r\n              ElMessage.error(response.message)\r\n            }\r\n          } catch (error) {\r\n            ElMessage.error('登录失败，请稍后重试')\r\n          } finally {\r\n            loading.value = false\r\n          }\r\n        }\r\n      })\r\n    }\r\n\r\n    // 发送验证码\r\n    const sendCode = async (type) => {\r\n      const phone = type === 'reset' ? resetForm.phone : smsForm.phone\r\n      const phoneReg = /^1[3-9]\\d{9}$/\r\n      \r\n      if (!phone) {\r\n        ElMessage.warning('请输入手机号')\r\n        return\r\n      }\r\n      if (!phoneReg.test(phone)) {\r\n        ElMessage.warning('手机号格式不正确')\r\n        return\r\n      }\r\n\r\n      try {\r\n        const response = await sendVerificationCode({\r\n          phone,\r\n          type: type === 'reset' ? 'reset' : 'login'\r\n        })\r\n        \r\n        if (response.code === 200) {\r\n          ElMessage.success('验证码已发送')\r\n          \r\n          // 开始倒计时\r\n          const countdownRef = type === 'reset' ? resetCountdown : countdown\r\n          countdownRef.value = 60\r\n          const timer = setInterval(() => {\r\n            countdownRef.value--\r\n            if (countdownRef.value <= 0) {\r\n              clearInterval(timer)\r\n            }\r\n          }, 1000)\r\n        } else {\r\n          ElMessage.error(response.message)\r\n        }\r\n      } catch (error) {\r\n        ElMessage.error('发送失败，请稍后重试')\r\n      }\r\n    }\r\n\r\n    // 重置密码\r\n    const handleResetPassword = () => {\r\n      resetFormRef.value.validate(async (valid) => {\r\n        if (valid) {\r\n          loading.value = true\r\n          try {\r\n            const response = await resetPassword(resetForm)\r\n            if (response.code === 200) {\r\n              ElMessage.success('密码重置成功')\r\n              showResetDialog.value = false\r\n              // 清空表单\r\n              resetFormRef.value.resetFields()\r\n            } else {\r\n              ElMessage.error(response.message)\r\n            }\r\n          } catch (error) {\r\n            ElMessage.error('重置失败，请稍后重试')\r\n          } finally {\r\n            loading.value = false\r\n          }\r\n        }\r\n      })\r\n    }\r\n\r\n    return {\r\n      loading,\r\n      loginType,\r\n      rememberMe,\r\n      showResetDialog,\r\n      countdown,\r\n      resetCountdown,\r\n      passwordFormRef,\r\n      passwordForm,\r\n      passwordRules,\r\n      smsFormRef,\r\n      smsForm,\r\n      smsRules,\r\n      resetFormRef,\r\n      resetForm,\r\n      resetRules,\r\n      handlePasswordLogin,\r\n      handleSmsLogin,\r\n      sendCode,\r\n      handleResetPassword\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n}\r\n\r\n.login-box {\r\n  width: 400px;\r\n  padding: 40px;\r\n  background: #fff;\r\n  border-radius: 10px;\r\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.login-title {\r\n  text-align: center;\r\n  font-size: 28px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.login-tabs {\r\n  display: flex;\r\n  margin-bottom: 30px;\r\n  border-bottom: 2px solid #f0f0f0;\r\n}\r\n\r\n.tab-item {\r\n  flex: 1;\r\n  text-align: center;\r\n  padding: 12px 0;\r\n  font-size: 16px;\r\n  color: #666;\r\n  cursor: pointer;\r\n  transition: a
{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, reactive, onMounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport NavBar from '@/components/NavBar.vue';\nimport { getMyFavoriteList, cancelFavorite } from '@/api/favorite';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nexport default {\n  __name: 'Favorites',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const favorites = ref([]);\n    const loading = ref(false);\n    const pagination = reactive({\n      page: 1,\n      page_size: 10,\n      total: 0\n    });\n    const loadData = async () => {\n      loading.value = true;\n      try {\n        const res = await getMyFavoriteList({\n          page: pagination.page,\n          page_size: pagination.page_size\n        });\n        if (res.code === 200) {\n          pagination.total = res.data.total;\n          favorites.value = res.data.list.map(item => ({\n            favorite_id: item.favorite_id,\n            product_id: item.product_id,\n            title: item.title,\n            price: item.price,\n            category: item.category,\n            created_at: item.created_at,\n            cover: item.images && item.images.length ? item.images[0] : '',\n            seller: item.seller || {}\n          }));\n        }\n      } catch (error) {\n        ElMessage.error('加载收藏列表失败');\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handlePageChange = p => {\n      pagination.page = p;\n      loadData();\n    };\n    const goDetail = id => {\n      router.push(`/product/${id}`);\n    };\n    const cancel = productId => {\n      ElMessageBox.confirm('确定取消收藏吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        const res = await cancelFavorite(productId);\n        if (res.code === 200) {\n          ElMessage.success('已取消收藏');\n          loadData();\n        } else {\n          ElMessage.error(res.message || '取消失败');\n        }\n      }).catch(() => {});\n    };\n    onMounted(loadData);\n    const __returned__ = {\n      router,\n      favorites,\n      loading,\n      pagination,\n      loadData,\n      handlePageChange,\n      goDetail,\n      cancel,\n      ref,\n      reactive,\n      onMounted,\n      get useRouter() {\n        return useRouter;\n      },\n      NavBar,\n      get getMyFavoriteList() {\n        return getMyFavoriteList;\n      },\n      get cancelFavorite() {\n        return cancelFavorite;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","useRouter","NavBar","getMyFavoriteList","cancelFavorite","ElMessage","ElMessageBox","router","favorites","loading","pagination","page","page_size","total","loadData","value","res","code","data","list","map","item","favorite_id","product_id","title","price","category","created_at","cover","images","length","seller","error","handlePageChange","p","goDetail","id","push","cancel","productId","confirm","confirmButtonText","cancelButtonText","type","then","success","message","catch"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/Favorites.vue"],"sourcesContent":["<template>\r\n  <div class=\"favorites-container\">\r\n    <NavBar />\r\n    <div class=\"content-wrapper\">\r\n      <el-card>\r\n        <template #header>\r\n          <div class=\"card-header\">\r\n            <span>我的收藏</span>\r\n          </div>\r\n        </template>\r\n\r\n        <el-table :data=\"favorites\" v-loading=\"loading\" style=\"width: 100%\">\r\n          <el-table-column label=\"图片\" width=\"120\">\r\n            <template #default=\"{ row }\">\r\n              <img\r\n                v-if=\"row.cover\"\r\n                :src=\"row.cover\"\r\n                class=\"thumb\"\r\n              />\r\n              <div v-else class=\"no-img\">无图</div>\r\n            </template>\r\n          </el-table-column>\r\n\r\n          <el-table-column prop=\"title\" label=\"标题\" min-width=\"200\" />\r\n\r\n          <el-table-column label=\"价格\" width=\"120\">\r\n            <template #default=\"{ row }\">\r\n              <span class=\"price\">¥ {{ row.price }}</span>\r\n            </template>\r\n          </el-table-column>\r\n\r\n          <el-table-column label=\"分类\" width=\"140\">\r\n            <template #default=\"{ row }\">\r\n              <el-tag size=\"small\">{{ row.category }}</el-tag>\r\n            </template>\r\n          </el-table-column>\r\n\r\n          <el-table-column label=\"卖家\" width=\"160\">\r\n            <template #default=\"{ row }\">\r\n              <div class=\"seller\">\r\n                <el-avatar :size=\"24\" :src=\"row.seller.avatar\" />\r\n                <span class=\"seller-name\">{{ row.seller.nickname }}</span>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n\r\n          <el-table-column prop=\"created_at\" label=\"收藏时间\" width=\"180\" />\r\n\r\n          <el-table-column label=\"操作\" width=\"180\" fixed=\"right\">\r\n            <template #default=\"{ row }\">\r\n              <el-button size=\"small\" @click=\"goDetail(row.product_id)\">查看</el-button>\r\n              <el-button size=\"small\" type=\"danger\" @click=\"cancel(row.product_id)\">取消收藏</el-button>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n\r\n        <div class=\"pagination\">\r\n          <el-pagination\r\n            background\r\n            layout=\"prev, pager, next\"\r\n            :total=\"pagination.total\"\r\n            :page-size=\"pagination.page_size\"\r\n            :current-page=\"pagination.page\"\r\n            @current-change=\"handlePageChange\"\r\n          />\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { getMyFavoriteList, cancelFavorite } from '@/api/favorite'\r\nimport { ElMessage, ElMessageBox } from 'element-plus'\r\n\r\nconst router = useRouter()\r\nconst favorites = ref([])\r\nconst loading = ref(false)\r\nconst pagination = reactive({ page: 1, page_size: 10, total: 0 })\r\n\r\nconst loadData = async () => {\r\n  loading.value = true\r\n  try {\r\n    const res = await getMyFavoriteList({ page: pagination.page, page_size: pagination.page_size })\r\n    if (res.code === 200) {\r\n      pagination.total = res.data.total\r\n      favorites.value = res.data.list.map(item => ({\r\n        favorite_id: item.favorite_id,\r\n        product_id: item.product_id,\r\n        title: item.title,\r\n        price: item.price,\r\n        category: item.category,\r\n        created_at: item.created_at,\r\n        cover: item.images && item.images.length ? item.images[0] : '',\r\n        seller: item.seller || {}\r\n      }))\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('加载收藏列表失败')\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n\r\nconst handlePageChange = (p) => {\r\n  pagination.page = p\r\n  loadData()\r\n}\r\n\r\nconst goDetail = (id) => {\r\n  router.push(`/product/${id}`)\r\n}\r\n\r\nconst cancel = (productId) => {\r\n  ElMessageBox.confirm('确定取消收藏吗？', '提示', {\r\n    confirmButtonText: '确定',\r\n    cancelButtonText: '取消',\r\n    type: 'warning'\r\n  }).then(async () => {\r\n    const res = await cancelFavorite(productId)\r\n    if (res.code === 200) {\r\n      ElMessage.success('已取消收藏')\r\n      loadData()\r\n    } else {\r\n      ElMessage.error(res.message || '取消失败')\r\n    }\r\n  }).catch(() => {})\r\n}\r\n\r\nonMounted(loadData)\r\n</script>\r\n\r\n<style scoped>\r\n.favorites-container {\r\n  min-height: 100vh;\r\n  background: #f5f7fa;\r\n}\r\n.content-wrapper {\r\n  max-width: 1100px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n.card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n.thumb {\r\n  width: 80px;\r\n  height: 80px;\r\n  object-fit: cover;\r\n  border-radius: 4px;\r\n}\r\n.no-img {\r\n  width: 80px;\r\n  height: 80px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: #f5f7fa;\r\n  color: #909399;\r\n  font-size: 12px;\r\n}\r\n.price {\r\n  color: #f56c6c;\r\n  font-weight: bold;\r\n}\r\n.seller {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.seller-name {\r\n  font-size: 13px;\r\n}\r\n.pagination {\r\n  margin-top: 16px;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n</style>\r\n"],"mappings":";;;AAwEA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SAASC,SAAS,QAAQ,YAAY;AACtC,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,iBAAiB,EAAEC,cAAc,QAAQ,gBAAgB;AAClE,SAASC,SAAS,EAAEC,YAAY,QAAQ,cAAc;;;;;;;IAEtD,MAAMC,MAAM,GAAGN,SAAS,CAAC,CAAC;IAC1B,MAAMO,SAAS,GAAGV,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMW,OAAO,GAAGX,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMY,UAAU,GAAGX,QAAQ,CAAC;MAAEY,IAAI,EAAE,CAAC;MAAEC,SAAS,EAAE,EAAE;MAAEC,KAAK,EAAE;IAAE,CAAC,CAAC;IAEjE,MAAMC,QAAQ,GAAG,MAAAA,CAAA,KAAY;MAC3BL,OAAO,CAACM,KAAK,GAAG,IAAI;MACpB,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMb,iBAAiB,CAAC;UAAEQ,IAAI,EAAED,UAAU,CAACC,IAAI;UAAEC,SAAS,EAAEF,UAAU,CAACE;QAAU,CAAC,CAAC;QAC/F,IAAII,GAAG,CAACC,IAAI,KAAK,GAAG,EAAE;UACpBP,UAAU,CAACG,KAAK,GAAGG,GAAG,CAACE,IAAI,CAACL,KAAK;UACjCL,SAAS,CAACO,KAAK,GAAGC,GAAG,CAACE,IAAI,CAACC,IAAI,CAACC,GAAG,CAACC,IAAI,KAAK;YAC3CC,WAAW,EAAED,IAAI,CAACC,WAAW;YAC7BC,UAAU,EAAEF,IAAI,CAACE,UAAU;YAC3BC,KAAK,EAAEH,IAAI,CAACG,KAAK;YACjBC,KAAK,EAAEJ,IAAI,CAACI,KAAK;YACjBC,QAAQ,EAAEL,IAAI,CAACK,QAAQ;YACvBC
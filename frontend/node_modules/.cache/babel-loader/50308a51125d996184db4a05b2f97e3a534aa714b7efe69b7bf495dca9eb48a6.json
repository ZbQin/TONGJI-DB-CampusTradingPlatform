{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport { Plus } from '@element-plus/icons-vue';\nimport NavBar from '@/components/NavBar.vue';\nimport { publishProduct, uploadProductImage } from '@/api/product';\nexport default {\n  __name: 'Publish',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const publishFormRef = ref(null);\n    const loading = ref(false);\n    const uploadedImages = ref([]);\n    const imageFiles = ref([]);\n    const form = reactive({\n      title: '',\n      price: 0,\n      category: '',\n      description: ''\n    });\n    const rules = {\n      title: [{\n        required: true,\n        message: '请输入商品标题',\n        trigger: 'blur'\n      }],\n      price: [{\n        required: true,\n        message: '请输入价格',\n        trigger: 'blur'\n      }],\n      category: [{\n        required: true,\n        message: '请选择分类',\n        trigger: 'change'\n      }],\n      description: [{\n        required: true,\n        message: '请输入商品描述',\n        trigger: 'blur'\n      }]\n    };\n    const handleFileChange = file => {\n      imageFiles.value.push(file.raw);\n    };\n    const submitForm = async () => {\n      if (!publishFormRef.value) return;\n      await publishFormRef.value.validate(async valid => {\n        if (valid) {\n          loading.value = true;\n          try {\n            // 上传所有图片\n            const imageUrls = [];\n            for (const file of imageFiles.value) {\n              const formData = new FormData();\n              formData.append('file', file);\n              const imgRes = await uploadProductImage(formData);\n              if (imgRes.code === 200) {\n                imageUrls.push(imgRes.data.image_url);\n              }\n            }\n\n            // 发布商品\n            const productData = {\n              ...form,\n              images: imageUrls\n            };\n            const res = await publishProduct(productData);\n            if (res.code === 200) {\n              ElMessage.success('发布成功');\n              router.push('/');\n            } else {\n              ElMessage.error(res.message || '发布失败');\n            }\n          } catch (error) {\n            console.error(error);\n            ElMessage.error('发布失败');\n          } finally {\n            loading.value = false;\n          }\n        }\n      });\n    };\n    const __returned__ = {\n      router,\n      publishFormRef,\n      loading,\n      uploadedImages,\n      imageFiles,\n      form,\n      rules,\n      handleFileChange,\n      submitForm,\n      ref,\n      reactive,\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get Plus() {\n        return Plus;\n      },\n      NavBar,\n      get publishProduct() {\n        return publishProduct;\n      },\n      get uploadProductImage() {\n        return uploadProductImage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","useRouter","ElMessage","Plus","NavBar","publishProduct","uploadProductImage","router","publishFormRef","loading","uploadedImages","imageFiles","form","title","price","category","description","rules","required","message","trigger","handleFileChange","file","value","push","raw","submitForm","validate","valid","imageUrls","formData","FormData","append","imgRes","code","data","image_url","productData","images","res","success","error","console"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/Publish.vue"],"sourcesContent":["<template>\r\n  <div class=\"publish-container\">\r\n    <NavBar />\r\n    \r\n    <div class=\"content-wrapper\">\r\n      <el-card class=\"publish-card\">\r\n        <template #header>\r\n          <div class=\"card-header\">\r\n            <span>发布商品</span>\r\n          </div>\r\n        </template>\r\n        \r\n        <el-form \r\n          ref=\"publishFormRef\"\r\n          :model=\"form\"\r\n          :rules=\"rules\"\r\n          label-width=\"100px\"\r\n          class=\"publish-form\"\r\n        >\r\n          <el-form-item label=\"商品标题\" prop=\"title\">\r\n            <el-input v-model=\"form.title\" placeholder=\"请输入商品标题（如：99新 iPad Air 5）\" />\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"商品价格\" prop=\"price\">\r\n            <el-input-number v-model=\"form.price\" :precision=\"2\" :step=\"1\" :min=\"0\" />\r\n            <span class=\"unit\">元</span>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"商品分类\" prop=\"category\">\r\n            <el-select v-model=\"form.category\" placeholder=\"请选择分类\">\r\n              <el-option label=\"书籍教材\" value=\"书籍教材\" />\r\n              <el-option label=\"电子数码\" value=\"电子数码\" />\r\n              <el-option label=\"生活用品\" value=\"生活用品\" />\r\n              <el-option label=\"美妆护肤\" value=\"美妆护肤\" />\r\n              <el-option label=\"运动器材\" value=\"运动器材\" />\r\n              <el-option label=\"其他\" value=\"其他\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"商品描述\" prop=\"description\">\r\n            <el-input \r\n              v-model=\"form.description\" \r\n              type=\"textarea\" \r\n              :rows=\"4\" \r\n              placeholder=\"描述一下商品的成色、入手渠道、转手原因等...\" \r\n            />\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"商品图片\">\r\n            <el-upload\r\n              class=\"avatar-uploader\"\r\n              action=\"#\"\r\n              :show-file-list=\"false\"\r\n              :auto-upload=\"false\"\r\n              :on-change=\"handleFileChange\"\r\n            >\r\n              <img v-if=\"imageUrl\" :src=\"imageUrl\" class=\"avatar\" />\r\n              <el-icon v-else class=\"avatar-uploader-icon\"><Plus /></el-icon>\r\n            </el-upload>\r\n            <div class=\"upload-tip\">支持 jpg/png 格式，大小不超过 2MB</div>\r\n          </el-form-item>\r\n          \r\n          <el-form-item>\r\n            <el-button type=\"primary\" @click=\"submitForm\" :loading=\"loading\">立即发布</el-button>\r\n            <el-button @click=\"$router.back()\">取消</el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport { Plus } from '@element-plus/icons-vue'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { publishProduct, uploadProductImage } from '@/api/product'\r\n\r\nconst router = useRouter()\r\nconst publishFormRef = ref(null)\r\nconst loading = ref(false)\r\nconst uploadedImages = ref([])\r\nconst imageFiles = ref([])\r\n\r\nconst form = reactive({\r\n  title: '',\r\n  price: 0,\r\n  category: '',\r\n  description: ''\r\n})\r\n\r\nconst rules = {\r\n  title: [{ required: true, message: '请输入商品标题', trigger: 'blur' }],\r\n  price: [{ required: true, message: '请输入价格', trigger: 'blur' }],\r\n  category: [{ required: true, message: '请选择分类', trigger: 'change' }],\r\n  description: [{ required: true, message: '请输入商品描述', trigger: 'blur' }]\r\n}\r\n\r\nconst handleFileChange = (file) => {\r\n  imageFiles.value.push(file.raw)\r\n}\r\n\r\nconst submitForm = async () => {\r\n  if (!publishFormRef.value) return\r\n  \r\n  await publishFormRef.value.validate(async (valid) => {\r\n    if (valid) {\r\n      loading.value = true\r\n      try {\r\n        // 上传所有图片\r\n        const imageUrls = []\r\n        for (const file of imageFiles.value) {\r\n          const formData = new FormData()\r\n          formData.append('file', file)\r\n          const imgRes = await uploadProductImage(formData)\r\n          if (imgRes.code === 200) {\r\n            imageUrls.push(imgRes.data.image_url)\r\n          }\r\n        }\r\n        \r\n        // 发布商品\r\n        const productData = { \r\n          ...form, \r\n          images: imageUrls\r\n        }\r\n        const res = await publishProduct(productData)\r\n        \r\n        if (res.code === 200) {\r\n          ElMessage.success('发布成功')\r\n          router.push('/')\r\n        } else {\r\n          ElMessage.error(res.message || '发布失败')\r\n        }\r\n      } catch (error) {\r\n        console.error(error)\r\n        ElMessage.error('发布失败')\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n  })\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.publish-container {\r\n  min-height: 100vh;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.content-wrapper {\r\n  max-width: 800px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n.publish-card {\r\n  border-radius: 8px;\r\n}\r\n\r\n.card-header {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n}\r\n\r\n.unit {\r\n  margin-left: 10px;\r\n  color: #606266;\r\n}\r\n\r\n.avatar-uploader .el-upload {\r\n  border: 1px dashed #d9d9d9;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n  transition: var(--el-transition-duration-fast);\r\n}\r\n\r\n.avatar-uploader .el-upload:hover {\r\n  border-color: var(--el-color-primary);\r\n}\r\n\r\n.avatar-uploader-icon {\r\n  font-size: 28px;\r\n  color: #8c939d;\r\n  width: 148px;\r\n  height: 148px;\r\n  text-align: center;\r\n  line-height: 148px;\r\n  border: 1px dashed #d9d9d9;\r\n  border-radius: 6px;\r\n}\r\n\r\n.avatar {\r\n  width: 148px;\r\n  height: 148px;\r\n  display: block;\r\n}\r\n\r\n.upload-tip {\r\n  font-size: 12px;\r\n  color: #909399;\r\n  margin-top: 5px;\r\n}\r\n</style>"],"mappings":";AAyEA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,SAAS,QAAQ,cAAc;AACxC,SAASC,IAAI,QAAQ,yBAAy
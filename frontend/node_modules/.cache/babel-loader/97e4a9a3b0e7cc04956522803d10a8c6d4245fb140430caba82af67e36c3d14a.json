{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport NavBar from '@/components/NavBar.vue';\nimport { ElMessage } from 'element-plus';\nimport { getProductDetail } from '@/api/product';\nimport { getOrCreateSession } from '@/api/chat';\nexport default {\n  __name: 'ProductDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const router = useRouter();\n    const product = ref({});\n    const loading = ref(false);\n    onMounted(async () => {\n      const id = route.params.id;\n      loading.value = true;\n      try {\n        const res = await getProductDetail(id);\n        if (res.code === 200) {\n          const data = res.data;\n          product.value = {\n            id: data.product_id,\n            title: data.title,\n            price: data.price,\n            seller: data.seller.nickname,\n            sellerId: data.seller.user_id,\n            time: data.created_at,\n            category: data.category,\n            description: data.description,\n            image: data.images && data.images.length > 0 ? data.images[0].image_url : ''\n          };\n        }\n      } catch (error) {\n        console.error(error);\n        ElMessage.error('加载商品详情失败');\n      } finally {\n        loading.value = false;\n      }\n    });\n    const handleContact = async () => {\n      try {\n        const res = await getOrCreateSession({\n          product_id: product.value.id,\n          seller_id: product.value.sellerId\n        });\n        if (res.code === 200) {\n          // 跳转到聊天页面\n          router.push('/chat');\n          ElMessage.success('已为您创建会话');\n        } else {\n          ElMessage.error(res.message || '创建会话失败');\n        }\n      } catch (error) {\n        ElMessage.error('创建会话失败');\n      }\n    };\n    const handleCollect = () => {\n      ElMessage.success('收藏成功');\n    };\n    const __returned__ = {\n      route,\n      router,\n      product,\n      loading,\n      handleContact,\n      handleCollect,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      NavBar,\n      get ElMessage() {\n        return ElMessage;\n      },\n      get getProductDetail() {\n        return getProductDetail;\n      },\n      get getOrCreateSession() {\n        return getOrCreateSession;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","useRouter","NavBar","ElMessage","getProductDetail","getOrCreateSession","route","router","product","loading","id","params","value","res","code","data","product_id","title","price","seller","nickname","sellerId","user_id","time","created_at","category","description","image","images","length","image_url","error","console","handleContact","seller_id","push","success","message","handleCollect"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/ProductDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"detail-container\">\r\n    <NavBar />\r\n    \r\n    <div class=\"content-wrapper\">\r\n      <el-card class=\"product-detail-card\">\r\n        <div class=\"product-layout\">\r\n          <!-- 左侧图片 -->\r\n          <div class=\"image-section\">\r\n            <div class=\"main-image\">\r\n              <img v-if=\"product.image\" :src=\"product.image\" />\r\n              <div v-else class=\"no-image\">暂无图片</div>\r\n            </div>\r\n          </div>\r\n          \r\n          <!-- 右侧信息 -->\r\n          <div class=\"info-section\">\r\n            <h1 class=\"title\">{{ product.title }}</h1>\r\n            \r\n            <div class=\"price-box\">\r\n              <span class=\"currency\">¥</span>\r\n              <span class=\"price\">{{ product.price }}</span>\r\n            </div>\r\n            \r\n            <div class=\"meta-info\">\r\n              <div class=\"meta-item\">\r\n                <span class=\"label\">卖家：</span>\r\n                <span class=\"value\">{{ product.seller }}</span>\r\n              </div>\r\n              <div class=\"meta-item\">\r\n                <span class=\"label\">发布时间：</span>\r\n                <span class=\"value\">{{ product.time }}</span>\r\n              </div>\r\n              <div class=\"meta-item\">\r\n                <span class=\"label\">分类：</span>\r\n                <el-tag size=\"small\">{{ product.category }}</el-tag>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"description-box\">\r\n              <div class=\"label\">商品详情：</div>\r\n              <div class=\"content\">{{ product.description }}</div>\r\n            </div>\r\n            \r\n            <div class=\"action-buttons\">\r\n              <el-button type=\"primary\" size=\"large\" @click=\"handleContact\">联系卖家</el-button>\r\n              <el-button size=\"large\" @click=\"handleCollect\">收藏商品</el-button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useRoute, useRouter } from 'vue-router'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { ElMessage } from 'element-plus'\r\nimport { getProductDetail } from '@/api/product'\r\nimport { getOrCreateSession } from '@/api/chat'\r\n\r\nconst route = useRoute()\r\nconst router = useRouter()\r\nconst product = ref({})\r\nconst loading = ref(false)\r\n\r\nonMounted(async () => {\r\n  const id = route.params.id\r\n  loading.value = true\r\n  try {\r\n    const res = await getProductDetail(id)\r\n    if (res.code === 200) {\r\n      const data = res.data\r\n      product.value = {\r\n        id: data.product_id,\r\n        title: data.title,\r\n        price: data.price,\r\n        seller: data.seller.nickname,\r\n        sellerId: data.seller.user_id,\r\n        time: data.created_at,\r\n        category: data.category,\r\n        description: data.description,\r\n        image: data.images && data.images.length > 0 ? data.images[0].image_url : ''\r\n      }\r\n    }\r\n  } catch (error) {\r\n    console.error(error)\r\n    ElMessage.error('加载商品详情失败')\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n})\r\n\r\nconst handleContact = async () => {\r\n  try {\r\n    const res = await getOrCreateSession({\r\n      product_id: product.value.id,\r\n      seller_id: product.value.sellerId\r\n    })\r\n    \r\n    if (res.code === 200) {\r\n      // 跳转到聊天页面\r\n      router.push('/chat')\r\n      ElMessage.success('已为您创建会话')\r\n    } else {\r\n      ElMessage.error(res.message || '创建会话失败')\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('创建会话失败')\r\n  }\r\n}\r\n\r\nconst handleCollect = () => {\r\n  ElMessage.success('收藏成功')\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.detail-container {\r\n  min-height: 100vh;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.content-wrapper {\r\n  max-width: 1000px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n.product-layout {\r\n  display: flex;\r\n  gap: 40px;\r\n}\r\n\r\n.image-section {\r\n  flex: 1;\r\n  max-width: 400px;\r\n}\r\n\r\n.main-image {\r\n  width: 100%;\r\n  height: 400px;\r\n  background-color: #f5f7fa;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.main-image img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.no-image {\r\n  color: #909399;\r\n}\r\n\r\n.info-section {\r\n  flex: 1;\r\n}\r\n\r\n.title {\r\n  font-size: 24px;\r\n  color: #303133;\r\n  margin: 0 0 20px;\r\n}\r\n\r\n.price-box {\r\n  background-color: #fef0f0;\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  margin-bottom: 20px;\r\n  color: #f56c6c;\r\n}\r\n\r\n.currency {\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n}\r\n\r\n.price {\r\n  font-size: 32px;\r\n  font-weight: bold;\r\n  margin-left: 5px;\r\n}\r\n\r\n.meta-info {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.meta-item {\r\n  margin-bottom: 10px;\r\n  font-size: 14px;\r\n  color: #606266;\r\n}\r\n\r\n.meta-item .label {\r\n  color: #909399;\r\n  margin-right: 10px;\r\n}\r\n\r\n.description-box {\r\n  margin-bottom: 30px;\r\n  border-top: 1px solid #ebeef5;\r\n  padding-top: 20px;\r\n}\r\n\r\n.description-box .label {\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n  color: #303133;\r\n}\r\n\r\n.description-box .content {\r\n  line-height: 1.6;\r\n  color: #606266;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .product-layout {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .image-section {\r\n    max-width: 100%;\r\n  }\r\n  \r\n  .main-image {\r\n    height: 300px;\r\n  }\r\n}\r\n</style>"],"mappings":";AAwDA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAY;AAChD,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,SAAS,QAAQ,cAAc;AACxC,SAASC,gBAAgB,QAAQ,eAAe;AAChD,SAASC,kBAAkB,QAAQ,YAAY;;;;;;;IAE/C,MAAMC,KAAK,GAAGN,QAAQ,CAAC,CAAC;IACxB,MAAMO,MAAM,GAAGN,SAAS,CAAC,CAAC;IAC1B,MAAMO,OAAO,GAAGV,GAAG,CAAC,CAAC,CAAC,CAAC;IACvB,MAAMW,OAAO,GAAGX,GAAG,CAAC,KAAK,CAAC;IAE1BC,SAAS,CAAC,YAAY;MACpB,MAAMW,EAAE,GAAGJ,KAAK,CAACK,MAAM,CAACD,EAAE;MAC1BD,OAAO,CAACG,KAAK,GAAG,IAAI;MACpB,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMT,gBAAgB,CAACM,EAAE,CAAC;QACtC,IAAIG,GAAG,CAACC,IAAI,KAAK,GAAG,EAAE;UACpB,MAAMC,IAAI,GAAGF,GAAG,CAACE,IAAI;UACrBP,OAAO,CAACI,KAAK,GAAG;YACdF,EAAE,EAAEK,IAAI,CAACC,UAAU;YACnBC,KAAK,EAAEF,IAAI,CAACE,KAAK;YACjBC,KAAK,EAAEH,IAAI,CAACG,KAAK;YACjBC,MAAM,EAAEJ,IAAI,CAACI,MAAM,CAACC,QAAQ;YAC5BC,QAAQ,EAAEN,IAAI,CAACI,MAAM,CAACG,OAAO;YAC7BC,IAAI,EAAER,IAAI,CAACS,UAAU;YACrBC,QAAQ,EAAEV,IAAI,CAACU,QAAQ;YACvBC,WAAW,EAAEX,IAAI,CAACW,WAAW;YAC7BC,KAAK,EAAEZ,IAAI,CAACa,MAAM,IAAIb,IAAI,CAACa,MAAM,CAACC,MAAM,G
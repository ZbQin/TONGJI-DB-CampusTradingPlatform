{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive } from 'vue';\nimport { useRouter } from 'vue-router';\nimport NavBar from '@/components/NavBar.vue';\nimport { Search } from '@element-plus/icons-vue';\nexport default {\n  __name: 'Home',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const searchQuery = ref('');\n    const selectedCategory = ref('全部');\n    const categories = ['全部', '书籍教材', '电子数码', '生活用品', '美妆护肤', '运动器材', '其他'];\n\n    // 模拟商品数据\n    const products = reactive([{\n      id: 1,\n      title: '二手高等数学教材',\n      price: 15.00,\n      seller: '张三',\n      time: '1小时前',\n      image: ''\n    }, {\n      id: 2,\n      title: '罗技无线鼠标',\n      price: 45.00,\n      seller: '李四',\n      time: '2小时前',\n      image: ''\n    }, {\n      id: 3,\n      title: '宜家台灯',\n      price: 30.00,\n      seller: '王五',\n      time: '5小时前',\n      image: ''\n    }, {\n      id: 4,\n      title: '考研英语资料',\n      price: 20.00,\n      seller: '赵六',\n      time: '1天前',\n      image: ''\n    }, {\n      id: 5,\n      title: '小米手环',\n      price: 80.00,\n      seller: '钱七',\n      time: '2天前',\n      image: ''\n    }, {\n      id: 6,\n      title: '自行车',\n      price: 200.00,\n      seller: '孙八',\n      time: '3天前',\n      image: ''\n    }]);\n    const goToDetail = id => {\n      router.push(`/product/${id}`);\n    };\n    const __returned__ = {\n      router,\n      searchQuery,\n      selectedCategory,\n      categories,\n      products,\n      goToDetail,\n      ref,\n      reactive,\n      get useRouter() {\n        return useRouter;\n      },\n      NavBar,\n      get Search() {\n        return Search;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","useRouter","NavBar","Search","router","searchQuery","selectedCategory","categories","products","id","title","price","seller","time","image","goToDetail","push"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/Home.vue"],"sourcesContent":["<template>\r\n  <div class=\"home-container\">\r\n    <NavBar />\r\n    \r\n    <div class=\"main-content\">\r\n      <!-- 搜索和筛选区 -->\r\n      <div class=\"filter-section\">\r\n        <el-input\r\n          v-model=\"searchQuery\"\r\n          placeholder=\"搜索商品...\"\r\n          class=\"search-input\"\r\n          :prefix-icon=\"Search\"\r\n          clearable\r\n        >\r\n          <template #append>\r\n            <el-button :icon=\"Search\" />\r\n          </template>\r\n        </el-input>\r\n        \r\n        <div class=\"category-tags\">\r\n          <el-tag \r\n            v-for=\"cat in categories\" \r\n            :key=\"cat\" \r\n            :effect=\"selectedCategory === cat ? 'dark' : 'plain'\"\r\n            class=\"category-tag\"\r\n            @click=\"selectedCategory = cat\"\r\n          >\r\n            {{ cat }}\r\n          </el-tag>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 商品列表区 -->\r\n      <div class=\"product-grid\">\r\n        <el-card \r\n          v-for=\"item in products\" \r\n          :key=\"item.id\" \r\n          class=\"product-card\" \r\n          :body-style=\"{ padding: '0px' }\"\r\n          shadow=\"hover\"\r\n          @click=\"goToDetail(item.id)\"\r\n        >\r\n          <div class=\"image-placeholder\">\r\n            <img v-if=\"item.image\" :src=\"item.image\" class=\"product-image\"/>\r\n            <div v-else class=\"no-image\">暂无图片</div>\r\n          </div>\r\n          <div class=\"product-info\">\r\n            <h3 class=\"product-title\">{{ item.title }}</h3>\r\n            <div class=\"product-price\">¥ {{ item.price }}</div>\r\n            <div class=\"product-meta\">\r\n              <span class=\"seller-name\">{{ item.seller }}</span>\r\n              <span class=\"publish-time\">{{ item.time }}</span>\r\n            </div>\r\n          </div>\r\n        </el-card>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { Search } from '@element-plus/icons-vue'\r\n\r\nconst router = useRouter()\r\nconst searchQuery = ref('')\r\nconst selectedCategory = ref('全部')\r\n\r\nconst categories = ['全部', '书籍教材', '电子数码', '生活用品', '美妆护肤', '运动器材', '其他']\r\n\r\n// 模拟商品数据\r\nconst products = reactive([\r\n  { id: 1, title: '二手高等数学教材', price: 15.00, seller: '张三', time: '1小时前', image: '' },\r\n  { id: 2, title: '罗技无线鼠标', price: 45.00, seller: '李四', time: '2小时前', image: '' },\r\n  { id: 3, title: '宜家台灯', price: 30.00, seller: '王五', time: '5小时前', image: '' },\r\n  { id: 4, title: '考研英语资料', price: 20.00, seller: '赵六', time: '1天前', image: '' },\r\n  { id: 5, title: '小米手环', price: 80.00, seller: '钱七', time: '2天前', image: '' },\r\n  { id: 6, title: '自行车', price: 200.00, seller: '孙八', time: '3天前', image: '' },\r\n])\r\n\r\nconst goToDetail = (id) => {\r\n  router.push(`/product/${id}`)\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.home-container {\r\n  min-height: 100vh;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.main-content {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.filter-section {\r\n  margin-bottom: 30px;\r\n  background: #fff;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0,0,0,0.05);\r\n}\r\n\r\n.search-input {\r\n  max-width: 500px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.category-tags {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.category-tag {\r\n  cursor: pointer;\r\n}\r\n\r\n.product-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\r\n  gap: 20px;\r\n}\r\n\r\n.product-card {\r\n  transition: transform 0.3s;\r\n  cursor: pointer;\r\n}\r\n\r\n.product-card:hover {\r\n  transform: translateY(-5px);\r\n}\r\n\r\n.image-placeholder {\r\n  height: 200px;\r\n  background-color: #e9e9eb;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  overflow: hidden;\r\n}\r\n\r\n.product-image {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.no-image {\r\n  color: #909399;\r\n}\r\n\r\n.product-info {\r\n  padding: 14px;\r\n}\r\n\r\n.product-title {\r\n  margin: 0 0 10px;\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.product-price {\r\n  color: #f56c6c;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.product-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  font-size: 12px;\r\n  color: #909399;\r\n}\r\n</style>\r\n"],"mappings":";AA6DA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SAASC,SAAS,QAAQ,YAAY;AACtC,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,MAAM,QAAQ,yBAAyB;;;;;;;IAEhD,MAAMC,MAAM,GAAGH,SAAS,CAAC,CAAC;IAC1B,MAAMI,WAAW,GAAGN,GAAG,CAAC,EAAE,CAAC;IAC3B,MAAMO,gBAAgB,GAAGP,GAAG,CAAC,IAAI,CAAC;IAElC,MAAMQ,UAAU,GAAG,CAAC,IAAI,EAAE,MAAM,EAAE,MAAM,EAAE,MAAM,EAAE,MAAM,EAAE,MAAM,EAAE,IAAI,CAAC;;IAEvE;IACA,MAAMC,QAAQ,GAAGR,QAAQ,CAAC,CACxB;MAAES,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE,UAAU;MAAEC,KAAK,EAAE,KAAK;MAAEC,MAAM,EAAE,IAAI;MAAEC,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAG,CAAC,EACjF;MAAEL,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE,QAAQ;MAAEC,KAAK,EAAE,KAAK;MAAEC,MAAM,EAAE,IAAI;MAAEC,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAG,CAAC,EAC/E;MAAEL,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE,KAAK;MAAEC,MAAM,EAAE,IAAI;MAAEC,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAG,CAAC,EAC7E;MAAEL,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE,QAAQ;MAAEC,KAAK,EAAE,KAAK;MAAEC,MAAM,EAAE,IAAI;MAAEC,IAAI,EAAE,KAAK;MAAEC,KAAK,EAAE;IAAG,CAAC,EAC9E;MAAEL,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE,KAAK;MAAEC,MAAM,EAAE,IAAI;MAAEC,IAAI,EAAE,KAAK;MAAEC,KAAK,EAAE;IAAG,CAAC,EAC5E;MAAEL,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE,KAAK;MAAEC,KAAK,EAAE,MAAM;MAAEC,MA
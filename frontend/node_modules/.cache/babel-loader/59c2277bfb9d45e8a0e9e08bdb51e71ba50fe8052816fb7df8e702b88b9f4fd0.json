{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive, onMounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport NavBar from '@/components/NavBar.vue';\nimport { publishWanted } from '@/api/wanted';\nimport { getCategoryList } from '@/api/category';\nexport default {\n  __name: 'WantedPublish',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const formRef = ref(null);\n    const loading = ref(false);\n    const categories = ref([]);\n    const form = reactive({\n      title: '',\n      category_id: null,\n      expected_price: 0,\n      description: ''\n    });\n    const rules = {\n      title: [{\n        required: true,\n        message: '请输入标题',\n        trigger: 'blur'\n      }],\n      category_id: [{\n        required: true,\n        message: '请选择分类',\n        trigger: 'change'\n      }],\n      expected_price: [{\n        required: true,\n        message: '请输入期望价格',\n        trigger: 'blur'\n      }],\n      description: [{\n        required: true,\n        message: '请输入描述',\n        trigger: 'blur'\n      }]\n    };\n    const loadCategories = async () => {\n      const res = await getCategoryList();\n      if (res.code === 200) categories.value = res.data;\n    };\n    const goHome = () => {\n      router.push('/');\n    };\n    const submit = async () => {\n      if (!formRef.value) return;\n      await formRef.value.validate(async valid => {\n        if (!valid) return;\n        loading.value = true;\n        try {\n          const res = await publishWanted({\n            ...form\n          });\n          if (res.code === 200) {\n            ElMessage.success('发布成功');\n            router.push('/wanted');\n          } else {\n            ElMessage.error(res.message || '发布失败');\n          }\n        } catch (error) {\n          ElMessage.error('发布失败');\n        } finally {\n          loading.value = false;\n        }\n      });\n    };\n    onMounted(loadCategories);\n    const __returned__ = {\n      router,\n      formRef,\n      loading,\n      categories,\n      form,\n      rules,\n      loadCategories,\n      goHome,\n      submit,\n      ref,\n      reactive,\n      onMounted,\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      NavBar,\n      get publishWanted() {\n        return publishWanted;\n      },\n      get getCategoryList() {\n        return getCategoryList;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","useRouter","ElMessage","NavBar","publishWanted","getCategoryList","router","formRef","loading","categories","form","title","category_id","expected_price","description","rules","required","message","trigger","loadCategories","res","code","value","data","goHome","push","submit","validate","valid","success","error"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/WantedPublish.vue"],"sourcesContent":["<template>\r\n  <div class=\"wanted-publish-container\">\r\n    <NavBar />\r\n    <div class=\"page-shell\">\r\n      <div class=\"hero-shell publish-hero\">\r\n        <div>\r\n          <div class=\"floating-badge\">发布求购</div>\r\n          <h2>描述需求，同学更快响应</h2>\r\n          <p class=\"section-sub\">填写标题、分类和期望价格，帮助卖家精准匹配</p>\r\n        </div>\r\n        <el-button class=\"ghost-button\" @click=\"goHome\">返回首页</el-button>\r\n      </div>\r\n\r\n      <el-card class=\"soft-card glass\">\r\n        <template #header>\r\n          <div class=\"card-header\">\r\n            <span>求购信息</span>\r\n          </div>\r\n        </template>\r\n\r\n        <el-form ref=\"formRef\" :model=\"form\" :rules=\"rules\" label-width=\"100px\" class=\"form-body\">\r\n          <el-form-item label=\"标题\" prop=\"title\">\r\n            <el-input v-model=\"form.title\" placeholder=\"如：求购二手iPad\" />\r\n          </el-form-item>\r\n          <el-form-item label=\"分类\" prop=\"category_id\">\r\n            <el-select v-model=\"form.category_id\" placeholder=\"请选择分类\">\r\n              <el-option v-for=\"c in categories\" :key=\"c.category_id\" :label=\"c.name\" :value=\"c.category_id\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item label=\"期望价格\" prop=\"expected_price\">\r\n            <el-input-number v-model=\"form.expected_price\" :min=\"0\" :step=\"10\" />\r\n          </el-form-item>\r\n          <el-form-item label=\"描述\" prop=\"description\">\r\n            <el-input type=\"textarea\" v-model=\"form.description\" :rows=\"4\" placeholder=\"描述需求、成色期望等\" />\r\n          </el-form-item>\r\n          <el-form-item class=\"actions-row\">\r\n            <el-button type=\"primary\" :loading=\"loading\" @click=\"submit\">发布</el-button>\r\n            <el-button class=\"ghost-button\" @click=\"goHome\">返回首页</el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { publishWanted } from '@/api/wanted'\r\nimport { getCategoryList } from '@/api/category'\r\n\r\nconst router = useRouter()\r\nconst formRef = ref(null)\r\nconst loading = ref(false)\r\nconst categories = ref([])\r\nconst form = reactive({\r\n  title: '',\r\n  category_id: null,\r\n  expected_price: 0,\r\n  description: ''\r\n})\r\n\r\nconst rules = {\r\n  title: [{ required: true, message: '请输入标题', trigger: 'blur' }],\r\n  category_id: [{ required: true, message: '请选择分类', trigger: 'change' }],\r\n  expected_price: [{ required: true, message: '请输入期望价格', trigger: 'blur' }],\r\n  description: [{ required: true, message: '请输入描述', trigger: 'blur' }]\r\n}\r\n\r\nconst loadCategories = async () => {\r\n  const res = await getCategoryList()\r\n  if (res.code === 200) categories.value = res.data\r\n}\r\n\r\nconst goHome = () => {\r\n  router.push('/')\r\n}\r\n\r\nconst submit = async () => {\r\n  if (!formRef.value) return\r\n  await formRef.value.validate(async (valid) => {\r\n    if (!valid) return\r\n    loading.value = true\r\n    try {\r\n      const res = await publishWanted({ ...form })\r\n      if (res.code === 200) {\r\n        ElMessage.success('发布成功')\r\n        router.push('/wanted')\r\n      } else {\r\n        ElMessage.error(res.message || '发布失败')\r\n      }\r\n    } catch (error) {\r\n      ElMessage.error('发布失败')\r\n    } finally {\r\n      loading.value = false\r\n    }\r\n  })\r\n}\r\n\r\nonMounted(loadCategories)\r\n</script>\r\n\r\n<style scoped>\r\n.wanted-publish {\r\n  min-height: 100vh;\r\n  background: var(--bg-page);\r\n}\r\n.page-shell {\r\n  max-width: 840px;\r\n  margin: 20px auto;\r\n  padding: 0 20px 30px;\r\n}\r\n.card-header {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n}\r\n\r\n.publish-hero {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  margin-bottom: 16px;\r\n  gap: 12px;\r\n}\r\n\r\n.form-body {\r\n  padding-top: 8px;\r\n}\r\n\r\n.actions-row {\r\n  margin-top: 8px;\r\n}\r\n</style>\r\n"],"mappings":";AA8CA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,SAAS,QAAQ,cAAc;AACxC,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,aAAa,QAAQ,cAAc;AAC5C,SAASC,eAAe,QAAQ,gBAAgB;;;;;;;IAEhD,MAAMC,MAAM,GAAGL,SAAS,CAAC,CAAC;IAC1B,MAAMM,OAAO,GAAGT,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMU,OAAO,GAAGV,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMW,UAAU,GAAGX,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMY,IAAI,GAAGX,QAAQ,CAAC;MACpBY,KAAK,EAAE,EAAE;MACTC,WAAW,EAAE,IAAI;MACjBC,cAAc,EAAE,CAAC;MACjBC,WAAW,EAAE;IACf,CAAC,CAAC;IAEF,MAAMC,KAAK,GAAG;MACZJ,KAAK,EAAE,CAAC;QAAEK,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,
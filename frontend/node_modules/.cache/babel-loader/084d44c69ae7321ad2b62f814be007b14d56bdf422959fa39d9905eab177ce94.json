{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { ref, reactive, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport { Plus } from '@element-plus/icons-vue';\nimport NavBar from '@/components/NavBar.vue';\nimport { getCategoryList } from '@/api/category';\nimport { getProductDetail, updateProduct, uploadProductImage } from '@/api/product';\nexport default {\n  __name: 'ProductEdit',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const router = useRouter();\n    const productId = route.params.id;\n    const formRef = ref(null);\n    const loading = ref(false);\n    const categories = ref([]);\n    const existingImages = ref([]);\n    const newImageFiles = ref([]);\n    const newImagePreviews = ref([]);\n    const form = reactive({\n      title: '',\n      price: 0,\n      category_id: null,\n      description: ''\n    });\n    const rules = {\n      title: [{\n        required: true,\n        message: '请输入商品标题',\n        trigger: 'blur'\n      }],\n      price: [{\n        required: true,\n        message: '请输入价格',\n        trigger: 'blur'\n      }],\n      category_id: [{\n        required: true,\n        message: '请选择分类',\n        trigger: 'change'\n      }],\n      description: [{\n        required: true,\n        message: '请输入商品描述',\n        trigger: 'blur'\n      }]\n    };\n    const loadCategories = async () => {\n      const res = await getCategoryList();\n      if (res.code === 200) categories.value = res.data;\n    };\n    const loadDetail = async () => {\n      const res = await getProductDetail(productId);\n      if (res.code === 200 && res.data) {\n        const data = res.data;\n        form.title = data.title;\n        form.price = data.price;\n        form.category_id = data.category_id;\n        form.description = data.description;\n        existingImages.value = (data.images || []).map(img => img.image_url || img);\n      }\n    };\n    const goBack = () => router.back();\n    const handleFileChange = file => {\n      newImageFiles.value.push(file.raw);\n      if (file.raw) {\n        newImagePreviews.value.push(URL.createObjectURL(file.raw));\n      }\n    };\n    const removeExisting = idx => {\n      existingImages.value.splice(idx, 1);\n    };\n    const removeNew = idx => {\n      newImageFiles.value.splice(idx, 1);\n      newImagePreviews.value.splice(idx, 1);\n    };\n    const submit = async () => {\n      if (!formRef.value) return;\n      await formRef.value.validate(async valid => {\n        if (!valid) return;\n        loading.value = true;\n        try {\n          const uploaded = [];\n          for (const file of newImageFiles.value) {\n            const formData = new FormData();\n            formData.append('file', file);\n            const r = await uploadProductImage(formData);\n            if (r.code === 200 && r.data?.image_url) {\n              uploaded.push(r.data.image_url);\n            }\n          }\n          const payloadImages = [...existingImages.value, ...uploaded];\n          const payload = {\n            product_id: Number(productId),\n            title: form.title,\n            price: form.price,\n            category_id: form.category_id,\n            description: form.description,\n            images: payloadImages\n          };\n          const res = await updateProduct(payload);\n          if (res.code === 200) {\n            ElMessage.success('保存成功');\n            router.push('/my-items');\n          } else {\n            ElMessage.error(res.message || '保存失败');\n          }\n        } catch (error) {\n          ElMessage.error('保存失败');\n        } finally {\n          loading.value = false;\n        }\n      });\n    };\n    onMounted(async () => {\n      await Promise.all([loadCategories(), loadDetail()]);\n    });\n    const __returned__ = {\n      route,\n      router,\n      productId,\n      formRef,\n      loading,\n      categories,\n      existingImages,\n      newImageFiles,\n      newImagePreviews,\n      form,\n      rules,\n      loadCategories,\n      loadDetail,\n      goBack,\n      handleFileChange,\n      removeExisting,\n      removeNew,\n      submit,\n      ref,\n      reactive,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get Plus() {\n        return Plus;\n      },\n      NavBar,\n      get getCategoryList() {\n        return getCategoryList;\n      },\n      get getProductDetail() {\n        return getProductDetail;\n      },\n      get updateProduct() {\n        return updateProduct;\n      },\n      get uploadProductImage() {\n        return uploadProductImage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","useRoute","useRouter","ElMessage","Plus","NavBar","getCategoryList","getProductDetail","updateProduct","uploadProductImage","route","router","productId","params","id","formRef","loading","categories","existingImages","newImageFiles","newImagePreviews","form","title","price","category_id","description","rules","required","message","trigger","loadCategories","res","code","value","data","loadDetail","images","map","img","image_url","goBack","back","handleFileChange","file","push","raw","URL","createObjectURL","removeExisting","idx","splice","removeNew","submit","validate","valid","uploaded","formData","FormData","append","r","payloadImages","payload","product_id","Number","success","error","Promise","all"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/ProductEdit.vue"],"sourcesContent":["<template>\r\n  <div class=\"product-edit-container\">\r\n    <NavBar />\r\n    <div class=\"page-shell\">\r\n      <div class=\"hero-shell publish-hero\">\r\n        <div>\r\n          <div class=\"floating-badge\">编辑商品</div>\r\n          <h2>更新你的商品信息</h2>\r\n          <p class=\"section-sub\">调整价格、描述或图片，让买家获取最新信息</p>\r\n        </div>\r\n        <el-button class=\"ghost-button\" @click=\"goBack\">返回</el-button>\r\n      </div>\r\n\r\n      <el-card class=\"soft-card glass\">\r\n        <template #header>\r\n          <div class=\"card-header\">商品信息</div>\r\n        </template>\r\n\r\n        <el-form\r\n          ref=\"formRef\"\r\n          :model=\"form\"\r\n          :rules=\"rules\"\r\n          label-width=\"100px\"\r\n          class=\"form-body\"\r\n        >\r\n          <el-form-item label=\"商品标题\" prop=\"title\">\r\n            <el-input v-model=\"form.title\" placeholder=\"请输入商品标题\" />\r\n          </el-form-item>\r\n\r\n          <el-form-item label=\"商品价格\" prop=\"price\">\r\n            <el-input-number v-model=\"form.price\" :precision=\"2\" :step=\"1\" :min=\"0\" />\r\n            <span class=\"unit\">元</span>\r\n          </el-form-item>\r\n\r\n          <el-form-item label=\"商品分类\" prop=\"category_id\">\r\n            <el-select v-model=\"form.category_id\" placeholder=\"请选择分类\">\r\n              <el-option\r\n                v-for=\"cat in categories\"\r\n                :key=\"cat.category_id\"\r\n                :label=\"cat.name\"\r\n                :value=\"cat.category_id\"\r\n              />\r\n            </el-select>\r\n          </el-form-item>\r\n\r\n          <el-form-item label=\"商品描述\" prop=\"description\">\r\n            <el-input\r\n              v-model=\"form.description\"\r\n              type=\"textarea\"\r\n              :rows=\"4\"\r\n              placeholder=\"描述成色、配件、交易方式等\"\r\n            />\r\n          </el-form-item>\r\n\r\n          <el-form-item label=\"已上传图片\">\r\n            <div v-if=\"existingImages.length\" class=\"image-list\">\r\n              <div v-for=\"(img, idx) in existingImages\" :key=\"img\" class=\"image-thumb\">\r\n                <img :src=\"img\" alt=\"product\" />\r\n                <el-button type=\"danger\" text size=\"small\" @click=\"removeExisting(idx)\">移除</el-button>\r\n              </div>\r\n            </div>\r\n            <div v-else class=\"no-image\">暂无图片</div>\r\n          </el-form-item>\r\n\r\n          <el-form-item label=\"新增图片\">\r\n            <el-upload\r\n              class=\"image-uploader\"\r\n              action=\"#\"\r\n              list-type=\"picture-card\"\r\n              :show-file-list=\"false\"\r\n              :auto-upload=\"false\"\r\n              multiple\r\n              :on-change=\"handleFileChange\"\r\n            >\r\n              <el-icon><Plus /></el-icon>\r\n            </el-upload>\r\n            <div v-if=\"newImagePreviews.length\" class=\"image-list\">\r\n              <div v-for=\"(img, idx) in newImagePreviews\" :key=\"img\" class=\"image-thumb\">\r\n                <img :src=\"img\" alt=\"new\" />\r\n                <el-button type=\"primary\" text size=\"small\" @click=\"removeNew(idx)\">移除</el-button>\r\n              </div>\r\n            </div>\r\n            <div class=\"upload-tip\">第一张图将作为封面</div>\r\n          </el-form-item>\r\n\r\n          <el-form-item>\r\n            <el-button type=\"primary\" :loading=\"loading\" @click=\"submit\">保存修改</el-button>\r\n            <el-button @click=\"goBack\">取消</el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { useRoute, useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport { Plus } from '@element-plus/icons-vue'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { getCategoryList } from '@/api/category'\r\nimport { getProductDetail, updateProduct, uploadProductImage } from '@/api/product'\r\n\r\nconst route = useRoute()\r\nconst router = useRouter()\r\nconst productId = route.params.id\r\n\r\nconst formRef = ref(null)\r\nconst loading = ref(false)\r\nconst categories = ref([])\r\nconst existingImages = ref([])\r\nconst newImageFiles = ref([])\r\nconst newImagePreviews = ref([])\r\n\r\nconst form = reactive({\r\n  title: '',\r\n  price: 0,\r\n  category_id: null,\r\n  description: ''\r\n})\r\n\r\nconst rules = {\r\n  title: [{ required: true, message: '请输入商品标题', trigger: 'blur' }],\r\n  price: [{ required: true, message: '请输入价格', trigger: 'blur' }],\r\n  category_id: [{ required: true, message: '请选择分类', trigger: 'change' }],\r\n  description: [{ required: true, message: '请输入商品描述', trigger: 'blur' }]\r\n}\r\n\r\nconst loadCategories = async () => {\r\n  const res = await getCategoryList()\r\n  if (res.code === 200) categories.value = res.data\r\n}\r\n\r\nconst loadDetail = async () => {\r\n  const res = await getProductDetail(productId)\r\n  if (res.code === 200 && res.data) {\r\n    const data = res.data\r\n    form.title = data.title\r\n    form.price = data.price\r\n    form.category_id = data.category_id\r\n    form.description = data.description\r\n    existingImages.value = (data.images || []).map((img) => img.image_url || img)\r\n  }\r\n}\r\n\r\nconst goBack = () => router.back()\r\n\r\nconst handleFileChange = (file) => {\r\n  newImageFiles.value.push(file.raw)\r\n  if (file.raw) {\r\n    newImagePreviews.value.push(URL.createObjectURL(file.raw))\r\n  }\r\n}\r\n\r\nconst removeExisting = (idx) => {\r\n  existingImages.value.splice(idx, 1)\r\n}\r\n\r\nconst removeNew = (idx) => {\r\n  newImageFiles.value.splice(idx, 1)\r\n  newImagePreviews.value.splice(idx, 1)\r\n}\r\n\r\nconst submit = async () => {\r\n  if (!formRef.value) return\r\n  await formRef.value.validate(async (valid) => {\r\n    if (!valid) return\r\n    loading.value = true\r\n    try {\r\n      const uploaded = []\r\n      for (const file of newImageFiles.value) {\r\n        const formData = new FormData()\r\n        formData.append('file', file)\r\n        const r = await uploadProductImage(formData)\r\n        if (r.code === 200 && r.data?.image_url) {\r\n          uploaded.push(r.data.image_url)\r\n        }\r\n      }\r\n\r\n      const payloadImages = [...existingImages.value, ...uploaded]\r\n      const payload = {\r\n        product_id: Number(productId),\r\n        title: form.title,\r\n        price: form.price,\r\n        category_id: form.category_id,\r\n        description: form.description,\r\n        images: payloadImages\r\n      }\r\n\r\n      const res = await updateProduct(payload)\r\n      if (res.code === 200) {\r\n        ElMessage.success('保存成功')\r\n        router.push('/my-items')\r\n      } else {\r\n        ElMessage.error(res.message || '保存失败')\r\n      }\r\n    } catch (error) {\r\n      ElMessage.error('保存失败')\r\n    } finally {\r\n      loading.value = false\r\n    }\r\n  })\r\n}\r\n\r\nonMounted(async () => {\r\n  await Promise.all([loadCategories(), loadDetail()])\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.product-edit-container {\r\n  min-height: 100vh;\r\n  background: var(--bg-page);\r\n}\r\n.page-shell {\r\n  max-width: 900px;\r\n  margin: 20px auto;\r\n  padding: 0 20px 30px;\r\n}\r\n.card-header {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n}\r\n.form-body {\r\n  padding-top: 8px;\r\n}\r\n.unit {\r\n  margin-left: 8px;\r\n  color: #909399;\r\n}\r\n.image-list {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n.image-thumb {\r\n  width: 120px;\r\n  height: 120px;\r\n  position: relative;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  background: #f6f7f9;\r\n  border: 1px solid #ebeef5;\r\n}\r\n.image-thumb img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n.image-thumb .el-button {\r\n  position: absolute;\r\n  bottom: 4px;\r\n  left: 4px;\r\n}\r\n.no-image {\r\n  color: #909399;\r\n  font-size: 13px;\r\n}\r\n.upload-tip {\r\n  color: #909399;\r\n  font-size: 12px;\r\n  margin-top: 6px;\r\n}\r\n</style>\r\n"],"mappings":";;;;;;AAgGA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAY;AAChD,SAASC,SAAS,QAAQ,cAAc;AACxC,SAASC,IAAI,QAAQ,yBAAyB;AAC9C,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,eAAe,QAAQ,gBAAgB;AAChD,SAASC,gBAAgB,EAAEC,aAAa,EAAEC,kBAAkB,QAAQ,eAAe;;;;;;;IAEnF,MAAMC,KAAK,GAAGT,QAAQ,CAAC,CAAC;IACxB,MAAMU,MAAM,GAAGT,SAAS,CAAC,CAAC;IAC1B,MAAMU,SAAS,GAAGF,KAAK,CAACG,MAAM,CAACC,EAAE;IAEjC,MAAMC,OAAO,GAAGjB,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMkB,OAAO,GAAGlB,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMmB,UAAU,GAAGnB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMoB,cAAc,GAAGpB,GAAG,CAAC,EAAE,CAAC;IAC9B,MAAMqB,aAAa,GAAGrB,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMsB,gBAAgB,GAAGtB,GAAG,CAAC,EAAE,CAAC;IAEhC,MAAMuB,IAAI,GAAGtB,QAAQ,CAAC;MACpBuB,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,CAAC;MACRC,WAAW,EAAE,IAAI;MACjBC,WAAW,EAAE;IACf,CAAC,CAAC;IAEF,MAAMC,KAAK,GAAG;MACZJ,KAAK,EAAE,CAAC;QAAEK,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAChEN,KAAK,EAAE,CAAC;QAAEI,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAC9DL,WAAW,EAAE,CAAC;QAAEG,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MACtEJ,WAAW,EAAE,CAAC;QAAEE,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAO,CAAC;IACvE,CAAC;IAED,MAAMC,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,MAAMC,GAAG,GAAG,MAAMzB,eAAe,CAAC,CAAC;MACnC,IAAIyB,GAAG,CAACC,IAAI,KAAK,GAAG,EAAEf,UAAU,CAACgB,KAAK,GAAGF,GAAG,CAACG,IAAI;IACnD,CAAC;IAED,MAAMC,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,MAAMJ,GAAG,GAAG,MAAMxB,gBAAgB,CAACK,SAAS,CAAC;MAC7C,IAAImB,GAAG,CAACC,IAAI,KAAK,GAAG,IAAID,GAAG,CAACG,IAAI,EAAE;QAChC,MAAMA,IAAI,GAAGH,GAAG,CAACG,IAAI;QACrBb,IAAI,CAACC,KAAK,GAAGY,IAAI,CAACZ,KAAK;QACvBD,IAAI,CAACE,KAAK,GAAGW,IAAI,CAACX,KAAK;QACvBF,IAAI,CAACG,WAAW,GAAGU,IAAI,CAACV,WAAW;QACnCH,IAAI,CAACI,WAAW,G
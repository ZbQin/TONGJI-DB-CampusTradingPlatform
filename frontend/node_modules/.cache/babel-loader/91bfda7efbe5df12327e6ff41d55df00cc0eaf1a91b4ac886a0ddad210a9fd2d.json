{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive, onMounted } from 'vue';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport NavBar from '@/components/NavBar.vue';\nimport { getMyWantedList, updateWantedStatus, deleteWanted } from '@/api/wanted';\nimport { useRouter } from 'vue-router';\nexport default {\n  __name: 'MyWanted',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const list = ref([]);\n    const loading = ref(false);\n    const pagination = reactive({\n      page: 1,\n      page_size: 10,\n      total: 0\n    });\n    const loadData = async () => {\n      loading.value = true;\n      try {\n        const res = await getMyWantedList({\n          page: pagination.page,\n          page_size: pagination.page_size\n        });\n        if (res.code === 200) {\n          pagination.total = res.data.total;\n          list.value = res.data.list || [];\n        }\n      } catch (error) {\n        ElMessage.error('加载失败');\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handlePageChange = p => {\n      pagination.page = p;\n      loadData();\n    };\n    const updateStatus = async (row, status) => {\n      const res = await updateWantedStatus(row.wanted_id, status);\n      if (res.code === 200) {\n        ElMessage.success('状态已更新');\n      } else {\n        ElMessage.error(res.message || '更新失败');\n        loadData();\n      }\n    };\n    const remove = id => {\n      ElMessageBox.confirm('确定删除该求购吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        const res = await deleteWanted(id);\n        if (res.code === 200) {\n          ElMessage.success('已删除');\n          loadData();\n        } else {\n          ElMessage.error(res.message || '删除失败');\n        }\n      }).catch(() => {});\n    };\n    const goDetail = id => router.push(`/wanted/detail/${id}`);\n    const goEdit = id => router.push(`/wanted/edit/${id}`);\n    onMounted(loadData);\n    const __returned__ = {\n      router,\n      list,\n      loading,\n      pagination,\n      loadData,\n      handlePageChange,\n      updateStatus,\n      remove,\n      goDetail,\n      goEdit,\n      ref,\n      reactive,\n      onMounted,\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      NavBar,\n      get getMyWantedList() {\n        return getMyWantedList;\n      },\n      get updateWantedStatus() {\n        return updateWantedStatus;\n      },\n      get deleteWanted() {\n        return deleteWanted;\n      },\n      get useRouter() {\n        return useRouter;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","ElMessage","ElMessageBox","NavBar","getMyWantedList","updateWantedStatus","deleteWanted","useRouter","router","list","loading","pagination","page","page_size","total","loadData","value","res","code","data","error","handlePageChange","p","updateStatus","row","status","wanted_id","success","message","remove","id","confirm","confirmButtonText","cancelButtonText","type","then","catch","goDetail","push","goEdit"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/MyWanted.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-wanted-container\">\r\n    <NavBar />\r\n    <div class=\"content-wrapper\">\r\n      <el-card>\r\n        <template #header>\r\n          <div class=\"card-header\">\r\n            <span>我的求购</span>\r\n            <el-button type=\"primary\" size=\"small\" @click=\"$router.push('/wanted/publish')\">发布求购</el-button>\r\n          </div>\r\n        </template>\r\n\r\n        <el-table :data=\"list\" v-loading=\"loading\" style=\"width:100%\">\r\n          <el-table-column prop=\"title\" label=\"标题\" min-width=\"200\" />\r\n          <el-table-column label=\"分类\" width=\"120\">\r\n            <template #default=\"{ row }\"><el-tag size=\"small\">{{ row.category }}</el-tag></template>\r\n          </el-table-column>\r\n          <el-table-column label=\"期望价\" width=\"120\">\r\n            <template #default=\"{ row }\">¥ {{ row.expected_price }}</template>\r\n          </el-table-column>\r\n          <el-table-column label=\"状态\" width=\"120\">\r\n            <template #default=\"{ row }\">\r\n              <el-select v-model=\"row.status\" size=\"small\" @change=\"(val)=>updateStatus(row, val)\">\r\n                <el-option label=\"进行中\" :value=\"0\" />\r\n                <el-option label=\"已完成\" :value=\"1\" />\r\n                <el-option label=\"已取消\" :value=\"2\" />\r\n              </el-select>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"created_at\" label=\"创建时间\" width=\"180\" />\r\n          <el-table-column label=\"操作\" width=\"160\" fixed=\"right\">\r\n            <template #default=\"{ row }\">\r\n              <el-button size=\"small\" @click=\"goDetail(row.wanted_id)\">查看</el-button>\r\n              <el-button size=\"small\" type=\"primary\" link @click=\"goEdit(row.wanted_id)\">编辑</el-button>\r\n              <el-button size=\"small\" type=\"danger\" @click=\"remove(row.wanted_id)\">删除</el-button>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n\r\n        <div class=\"pagination\">\r\n          <el-pagination\r\n            background\r\n            layout=\"prev, pager, next\"\r\n            :total=\"pagination.total\"\r\n            :page-size=\"pagination.page_size\"\r\n            :current-page=\"pagination.page\"\r\n            @current-change=\"handlePageChange\"\r\n          />\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { ElMessage, ElMessageBox } from 'element-plus'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { getMyWantedList, updateWantedStatus, deleteWanted } from '@/api/wanted'\r\nimport { useRouter } from 'vue-router'\r\n\r\nconst router = useRouter()\r\nconst list = ref([])\r\nconst loading = ref(false)\r\nconst pagination = reactive({ page: 1, page_size: 10, total: 0 })\r\n\r\nconst loadData = async () => {\r\n  loading.value = true\r\n  try {\r\n    const res = await getMyWantedList({ page: pagination.page, page_size: pagination.page_size })\r\n    if (res.code === 200) {\r\n      pagination.total = res.data.total\r\n      list.value = res.data.list || []\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('加载失败')\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n\r\nconst handlePageChange = (p) => {\r\n  pagination.page = p\r\n  loadData()\r\n}\r\n\r\nconst updateStatus = async (row, status) => {\r\n  const res = await updateWantedStatus(row.wanted_id, status)\r\n  if (res.code === 200) {\r\n    ElMessage.success('状态已更新')\r\n  } else {\r\n    ElMessage.error(res.message || '更新失败')\r\n    loadData()\r\n  }\r\n}\r\n\r\nconst remove = (id) => {\r\n  ElMessageBox.confirm('确定删除该求购吗？', '提示', {\r\n    confirmButtonText: '确定',\r\n    cancelButtonText: '取消',\r\n    type: 'warning'\r\n  }).then(async () => {\r\n    const res = await deleteWanted(id)\r\n    if (res.code === 200) {\r\n      ElMessage.success('已删除')\r\n      loadData()\r\n    } else {\r\n      ElMessage.error(res.message || '删除失败')\r\n    }\r\n  }).catch(() => {})\r\n}\r\n\r\nconst goDetail = (id) => router.push(`/wanted/detail/${id}`)\r\nconst goEdit = (id) => router.push(`/wanted/edit/${id}`)\r\n\r\nonMounted(loadData)\r\n</script>\r\n\r\n<style scoped>\r\n.my-wanted-container {\r\n  min-height: 100vh;\r\n  background: #f5f7fa;\r\n}\r\n.content-wrapper {\r\n  max-width: 1000px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n.card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n.pagination {\r\n  margin-top: 16px;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n</style>\r\n"],"mappings":";AAuDA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SAASC,SAAS,EAAEC,YAAY,QAAQ,cAAc;AACtD,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,eAAe,EAAEC,kBAAkB,EAAEC,YAAY,QAAQ,cAAc;AAChF,SAASC,SAAS,QAAQ,YAAY;;;;;;;IAEtC,MAAMC,MAAM,GAAGD,SAAS,CAAC,CAAC;IAC1B,MAAME,IAAI,GAAGX,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMY,OAAO,GAAGZ,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMa,UAAU,GAAGZ,QAAQ,CAAC;MAAEa,IAAI,EAAE,CAAC;MAAEC,SAAS,EAAE,EAAE;MAAEC,KAAK,EAAE;IAAE,CAAC,CAAC;IAEjE,MAAMC,QAAQ,GAAG,MAAAA,CAAA,KAAY;MAC3BL,OAAO,CAACM,KAAK,GAAG,IAAI;MACpB,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMb,eAAe,CAAC;UAAEQ,IAAI,EAAED,UAAU,CAACC,IAAI;UAAEC,SAAS,EAAEF,UAAU,CAACE;QAAU,CAAC,CAAC;QAC7F,IAAII,GAAG,CAACC,IAAI,KAAK,GAAG,EAAE;UACpBP,UAAU,CAACG,KAAK,GAAGG,GAAG,CAACE,IAAI,CAACL,KAAK;UACjCL,IAAI,CAACO,KAAK,GAAGC,GAAG,CAACE,IAAI,CAACV,IAAI,IAAI,EAAE;QAClC;MACF,CAAC,CAAC,OAAOW,KAAK,EAAE;QACdnB,SAAS,CAACmB,KAAK,CAAC,MAAM,CAAC;MACzB,CAAC,SAAS;QACRV,OAAO,CAACM,KAAK,GAAG,KAAK;MACvB;IACF,CAAC;IAED,MAAMK,gBAAgB,GAAIC,CAAC,IAAK;MAC9BX,UAAU,CAACC,IAAI,GAAGU,CAAC;MACnBP,QAAQ,CAAC,CAAC;IACZ,CAAC;IAED,MAAMQ,YAAY,GAAG,MAAAA,CAAOC,GAAG,EAAEC,MAAM,KAAK;MAC1C,MAAMR,GAAG,GAAG,MAAMZ,kBAAkB,CAACmB,GAAG,CAACE,SAAS,EAAED,MAAM,CAAC;MAC3D,IAAIR,GAAG,CAACC,IAAI,KAAK,GAAG,EAAE;QACpBjB,SAAS,CAAC0B,OAAO,CAAC,OAAO,CAAC;MAC5B,CAAC,MAAM;QACL1B,SAAS,CAACmB,KAAK,CAACH,GAAG,CAACW,OAAO,IAAI,MAAM,CAAC;QACtCb,QAAQ,CAAC,CAAC;MACZ;IACF,CAAC;IAED,MAAMc,MAAM,GAAIC,EAAE,IAAK;MACrB5B,YAAY,CAAC6B,OAAO,CAAC,WAAW,EAAE,IAAI,EAAE;QACtCC,iBAAiB,EAAE,IAAI;QACvBC,gBAAgB,EAAE,IAAI;QACtBC,IAAI,EAAE;MACR,CAAC,CAAC,CAACC,IAAI,CAAC,YAAY;QAClB,MAAMlB,GAAG,GAAG,MAAMX,YAAY,CAACwB,EAAE,CAAC;QAClC,IAAIb,GAAG,CAACC,IAAI,KAAK,GAAG,EAAE;UACpBjB,SAAS,CAAC0B,OAAO,CAAC,KAAK,CAAC;UACxBZ,QAAQ,CAAC,CAAC;QACZ,CAAC,MAAM;UACLd,SAAS,CAACmB,KAAK,CAACH,GAAG,CAACW,OAAO,IAAI,MAAM,CAAC;QACxC;MACF,CAAC,CAAC,CAACQ,
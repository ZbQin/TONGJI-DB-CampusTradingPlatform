{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { ArrowRight } from '@element-plus/icons-vue';\nimport NavBar from '@/components/NavBar.vue';\nimport { getWantedDetail } from '@/api/wanted';\nimport { getOrCreateSession } from '@/api/chat';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'WantedDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const router = useRouter();\n    const detail = ref(null);\n    const loading = ref(false);\n    const statusText = s => {\n      if (s === 1) return '已完成';\n      if (s === 2) return '已取消';\n      return '进行中';\n    };\n    const statusType = s => {\n      if (s === 1) return 'success';\n      if (s === 2) return 'info';\n      return 'warning';\n    };\n    const loadDetail = async () => {\n      loading.value = true;\n      try {\n        const res = await getWantedDetail(route.params.id);\n        if (res.code === 200) {\n          detail.value = res.data;\n        }\n      } catch (error) {\n        ElMessage.error('加载详情失败');\n      } finally {\n        loading.value = false;\n      }\n    };\n    const goChat = async () => {\n      if (!detail.value) return;\n      try {\n        const res = await getOrCreateSession({\n          seller_id: detail.value.publisher.user_id\n        });\n        if (res.code === 200) {\n          ElMessage.success('已创建会话');\n          router.push('/chat');\n        }\n      } catch (error) {\n        ElMessage.error('创建会话失败');\n      }\n    };\n    onMounted(loadDetail);\n    const __returned__ = {\n      route,\n      router,\n      detail,\n      loading,\n      statusText,\n      statusType,\n      loadDetail,\n      goChat,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ArrowRight() {\n        return ArrowRight;\n      },\n      NavBar,\n      get getWantedDetail() {\n        return getWantedDetail;\n      },\n      get getOrCreateSession() {\n        return getOrCreateSession;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","useRouter","ArrowRight","NavBar","getWantedDetail","getOrCreateSession","ElMessage","route","router","detail","loading","statusText","s","statusType","loadDetail","value","res","params","id","code","data","error","goChat","seller_id","publisher","user_id","success","push"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/WantedDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"wanted-detail\">\r\n    <NavBar />\r\n    <div class=\"content-wrapper\" v-loading=\"loading\">\r\n      <el-card v-if=\"detail\">\r\n        <template #header>\r\n          <div class=\"card-header\">\r\n            <div class=\"title-box\">\r\n              <h2>{{ detail.title }}</h2>\r\n              <el-tag size=\"small\">{{ detail.category }}</el-tag>\r\n              <el-tag :type=\"statusType(detail.status)\" size=\"small\">{{ statusText(detail.status) }}</el-tag>\r\n            </div>\r\n            <div class=\"actions\">\r\n              <el-button type=\"primary\" plain @click=\"goChat\">联系Ta</el-button>\r\n            </div>\r\n          </div>\r\n        </template>\r\n\r\n        <div class=\"meta\">\r\n          <div class=\"meta-item publisher-card\" @click=\"goToUserProfile\">\r\n            <el-avatar :size=\"40\" class=\"publisher-avatar\">\r\n              {{ detail.publisher.nickname?.charAt(0) }}\r\n            </el-avatar>\r\n            <div class=\"publisher-info\">\r\n              <span class=\"label\">发布人：</span>\r\n              <span class=\"value publisher-name\">{{ detail.publisher.nickname }}</span>\r\n              <el-icon class=\"arrow-icon\"><ArrowRight /></el-icon>\r\n            </div>\r\n          </div>\r\n          <div>电话：{{ detail.publisher.phone || '未提供' }}</div>\r\n          <div>期望价：¥ {{ detail.expected_price }}</div>\r\n          <div>发布时间：{{ detail.created_at }}</div>\r\n          <div>更新时间：{{ detail.updated_at }}</div>\r\n        </div>\r\n\r\n        <div class=\"section\">\r\n          <h4>求购详情</h4>\r\n          <p>{{ detail.description }}</p>\r\n        </div>\r\n      </el-card>\r\n      <el-empty v-else description=\"未找到该求购\" />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useRoute, useRouter } from 'vue-router'\r\nimport { ArrowRight } from '@element-plus/icons-vue'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { getWantedDetail } from '@/api/wanted'\r\nimport { getOrCreateSession } from '@/api/chat'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nconst route = useRoute()\r\nconst router = useRouter()\r\nconst detail = ref(null)\r\nconst loading = ref(false)\r\n\r\nconst statusText = (s) => {\r\n  if (s === 1) return '已完成'\r\n  if (s === 2) return '已取消'\r\n  return '进行中'\r\n}\r\nconst statusType = (s) => {\r\n  if (s === 1) return 'success'\r\n  if (s === 2) return 'info'\r\n  return 'warning'\r\n}\r\n\r\nconst loadDetail = async () => {\r\n  loading.value = true\r\n  try {\r\n    const res = await getWantedDetail(route.params.id)\r\n    if (res.code === 200) {\r\n      detail.value = res.data\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('加载详情失败')\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n\r\nconst goChat = async () => {\r\n  if (!detail.value) return\r\n  try {\r\n    const res = await getOrCreateSession({ seller_id: detail.value.publisher.user_id })\r\n    if (res.code === 200) {\r\n      ElMessage.success('已创建会话')\r\n      router.push('/chat')\r\n    }\r\n  } catch (error) {\r\n    ElMessage.error('创建会话失败')\r\n  }\r\n}\r\n\r\nonMounted(loadDetail)\r\n</script>\r\n\r\n<style scoped>\r\n.wanted-detail {\r\n  min-height: 100vh;\r\n  background: #f5f7fa;\r\n}\r\n.content-wrapper {\r\n  max-width: 900px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n.title-box {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n.meta {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\r\n  gap: 8px;\r\n  margin-bottom: 16px;\r\n  color: #606266;\r\n}\r\n.section {\r\n  margin-top: 16px;\r\n}\r\n.section h4 {\r\n  margin-bottom: 8px;\r\n}\r\n.section p {\r\n  line-height: 1.6;\r\n  color: #303133;\r\n}\r\n</style>\r\n"],"mappings":";AA8CA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAY;AAChD,SAASC,UAAU,QAAQ,yBAAyB;AACpD,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,eAAe,QAAQ,cAAc;AAC9C,SAASC,kBAAkB,QAAQ,YAAY;AAC/C,SAASC,SAAS,QAAQ,cAAc;;;;;;;IAExC,MAAMC,KAAK,GAAGP,QAAQ,CAAC,CAAC;IACxB,MAAMQ,MAAM,GAAGP,SAAS,CAAC,CAAC;IAC1B,MAAMQ,MAAM,GAAGX,GAAG,CAAC,IAAI,CAAC;IACxB,MAAMY,OAAO,GAAGZ,GAAG,CAAC,KAAK,CAAC;IAE1B,MAAMa,UAAU,GAAIC,CAAC,IAAK;MACxB,IAAIA,CAAC,KAAK,CAAC,EAAE,OAAO,KAAK;MACzB,IAAIA,CAAC,KAAK,CAAC,EAAE,OAAO,KAAK;MACzB,OAAO,KAAK;IACd,CAAC;IACD,MAAMC,UAAU,GAAID,CAAC,IAAK;MACxB,IAAIA,CAAC,KAAK,CAAC,EAAE,OAAO,SAAS;MAC7B,IAAIA,CAAC,KAAK,CAAC,EAAE,OAAO,MAAM;MAC1B,OAAO,SAAS;IAClB,CAAC;IAED,MAAME,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7BJ,OAAO,CAACK,KAAK,GAAG,IAAI;MACpB,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMZ,eAAe,CAACG,KAAK,CAACU,MAAM,CAACC,EAAE,CAAC;QAClD,IAAIF,GAAG,CAACG,IAAI,KAAK,GAAG,EAAE;UACpBV,MAAM,CAACM,KAAK,GAAGC,GAAG,CAACI,IAAI;QACzB;MACF,CAAC,CAAC,OAAOC,KAAK,EAAE;QACdf,SAAS,CAACe,KAAK,CAAC,QAAQ,CAAC;MAC3B,CAAC,SAAS;QACRX,OAAO,CAACK,KAAK,GAAG,KAAK;MACvB;IACF,CAAC;IAED,MAAMO,MAAM,GAAG,MAAAA,CAAA,KAAY;MACzB,IAAI,CAACb,MAAM,CAACM,KAAK,EAAE;MACnB,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMX,kBAAkB,CAAC;U
{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport NavBar from '@/components/NavBar.vue';\nimport { publishWanted } from '@/api/wanted';\nimport { getCategoryList } from '@/api/category';\nexport default {\n  __name: 'WantedPublish',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const formRef = ref(null);\n    const loading = ref(false);\n    const categories = ref([]);\n    const form = reactive({\n      title: '',\n      category_id: null,\n      expected_price: 0,\n      description: '',\n      contact_info: ''\n    });\n    const rules = {\n      title: [{\n        required: true,\n        message: '请输入标题',\n        trigger: 'blur'\n      }],\n      category_id: [{\n        required: true,\n        message: '请选择分类',\n        trigger: 'change'\n      }],\n      expected_price: [{\n        required: true,\n        message: '请输入期望价格',\n        trigger: 'blur'\n      }],\n      description: [{\n        required: true,\n        message: '请输入描述',\n        trigger: 'blur'\n      }],\n      contact_info: [{\n        required: true,\n        message: '请输入联系方式',\n        trigger: 'blur'\n      }]\n    };\n    const loadCategories = async () => {\n      const res = await getCategoryList();\n      if (res.code === 200) categories.value = res.data;\n    };\n    const submit = async () => {\n      if (!formRef.value) return;\n      await formRef.value.validate(async valid => {\n        if (!valid) return;\n        loading.value = true;\n        try {\n          const res = await publishWanted({\n            ...form\n          });\n          if (res.code === 200) {\n            ElMessage.success('发布成功');\n            window.location.href = '/wanted';\n          } else {\n            ElMessage.error(res.message || '发布失败');\n          }\n        } catch (error) {\n          ElMessage.error('发布失败');\n        } finally {\n          loading.value = false;\n        }\n      });\n    };\n    onMounted(loadCategories);\n    const __returned__ = {\n      formRef,\n      loading,\n      categories,\n      form,\n      rules,\n      loadCategories,\n      submit,\n      ref,\n      reactive,\n      onMounted,\n      get ElMessage() {\n        return ElMessage;\n      },\n      NavBar,\n      get publishWanted() {\n        return publishWanted;\n      },\n      get getCategoryList() {\n        return getCategoryList;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","ElMessage","NavBar","publishWanted","getCategoryList","formRef","loading","categories","form","title","category_id","expected_price","description","contact_info","rules","required","message","trigger","loadCategories","res","code","value","data","submit","validate","valid","success","window","location","href","error"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/WantedPublish.vue"],"sourcesContent":["<template>\r\n  <div class=\"wanted-publish\">\r\n    <NavBar />\r\n    <div class=\"content-wrapper\">\r\n      <el-card>\r\n        <template #header>\r\n          <div class=\"card-header\">\r\n            <span>发布求购</span>\r\n          </div>\r\n        </template>\r\n\r\n        <el-form ref=\"formRef\" :model=\"form\" :rules=\"rules\" label-width=\"100px\">\r\n          <el-form-item label=\"标题\" prop=\"title\">\r\n            <el-input v-model=\"form.title\" placeholder=\"如：求购二手iPad\" />\r\n          </el-form-item>\r\n          <el-form-item label=\"分类\" prop=\"category_id\">\r\n            <el-select v-model=\"form.category_id\" placeholder=\"请选择分类\">\r\n              <el-option v-for=\"c in categories\" :key=\"c.category_id\" :label=\"c.name\" :value=\"c.category_id\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item label=\"期望价格\" prop=\"expected_price\">\r\n            <el-input-number v-model=\"form.expected_price\" :min=\"0\" :step=\"10\" />\r\n          </el-form-item>\r\n          <el-form-item label=\"描述\" prop=\"description\">\r\n            <el-input type=\"textarea\" v-model=\"form.description\" :rows=\"4\" placeholder=\"描述需求、成色期望等\" />\r\n          </el-form-item>\r\n          <el-form-item label=\"联系方式\" prop=\"contact_info\">\r\n            <el-input v-model=\"form.contact_info\" placeholder=\"微信/电话\" />\r\n          </el-form-item>\r\n          <el-form-item>\r\n            <el-button type=\"primary\" :loading=\"loading\" @click=\"submit\">发布</el-button>\r\n            <el-button @click=\"$router.back()\">取消</el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { ElMessage } from 'element-plus'\r\nimport NavBar from '@/components/NavBar.vue'\r\nimport { publishWanted } from '@/api/wanted'\r\nimport { getCategoryList } from '@/api/category'\r\n\r\nconst formRef = ref(null)\r\nconst loading = ref(false)\r\nconst categories = ref([])\r\nconst form = reactive({\r\n  title: '',\r\n  category_id: null,\r\n  expected_price: 0,\r\n  description: '',\r\n  contact_info: ''\r\n})\r\n\r\nconst rules = {\r\n  title: [{ required: true, message: '请输入标题', trigger: 'blur' }],\r\n  category_id: [{ required: true, message: '请选择分类', trigger: 'change' }],\r\n  expected_price: [{ required: true, message: '请输入期望价格', trigger: 'blur' }],\r\n  description: [{ required: true, message: '请输入描述', trigger: 'blur' }],\r\n  contact_info: [{ required: true, message: '请输入联系方式', trigger: 'blur' }]\r\n}\r\n\r\nconst loadCategories = async () => {\r\n  const res = await getCategoryList()\r\n  if (res.code === 200) categories.value = res.data\r\n}\r\n\r\nconst submit = async () => {\r\n  if (!formRef.value) return\r\n  await formRef.value.validate(async (valid) => {\r\n    if (!valid) return\r\n    loading.value = true\r\n    try {\r\n      const res = await publishWanted({ ...form })\r\n      if (res.code === 200) {\r\n        ElMessage.success('发布成功')\r\n        window.location.href = '/wanted'\r\n      } else {\r\n        ElMessage.error(res.message || '发布失败')\r\n      }\r\n    } catch (error) {\r\n      ElMessage.error('发布失败')\r\n    } finally {\r\n      loading.value = false\r\n    }\r\n  })\r\n}\r\n\r\nonMounted(loadCategories)\r\n</script>\r\n\r\n<style scoped>\r\n.wanted-publish {\r\n  min-height: 100vh;\r\n  background: #f5f7fa;\r\n}\r\n.content-wrapper {\r\n  max-width: 720px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n.card-header {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n}\r\n</style>\r\n"],"mappings":"AAwCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SAASC,SAAS,QAAQ,cAAc;AACxC,OAAOC,MAAM,MAAM,yBAAyB;AAC5C,SAASC,aAAa,QAAQ,cAAc;AAC5C,SAASC,eAAe,QAAQ,gBAAgB;;;;;;;IAEhD,MAAMC,OAAO,GAAGP,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMQ,OAAO,GAAGR,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMS,UAAU,GAAGT,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMU,IAAI,GAAGT,QAAQ,CAAC;MACpBU,KAAK,EAAE,EAAE;MACTC,WAAW,EAAE,IAAI;MACjBC,cAAc,EAAE,CAAC;MACjBC,WAAW,EAAE,EAAE;MACfC,YAAY,EAAE;IAChB,CAAC,CAAC;IAEF,MAAMC,KAAK,GAAG;MACZL,KAAK,EAAE,CAAC;QAAEM,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAC9DP,WAAW,EAAE,CAAC;QAAEK,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MACtEN,cAAc,EAAE,CAAC;QAAEI,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MACzEL,WAAW,EAAE,CAAC;QAAEG,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MACpEJ,YAAY,EAAE,CAAC;QAAEE,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAO,CAAC;IACxE,CAAC;IAED,MAAMC,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,MAAMC,GAAG,GAAG,MAAMf,eAAe,CAAC,CAAC;MACnC,IAAIe,GAAG,CAACC,IAAI,KAAK,GAAG,EAAEb,UAAU,CAACc,KAAK,GAAGF,GAAG,CAACG,IAAI;IACnD,CAAC;IAED,MAAMC,MAAM,GAAG,MAAAA,CAAA,KAAY;MACzB,IAAI,CAAClB,OAAO,CAACgB,KAAK,EAAE;MACpB,MAAMhB,OAAO,CAACgB,KAAK,CAACG,QAAQ,CAA
{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessageBox, ElMessage } from 'element-plus';\nimport NavBar from '@/components/NavBar.vue';\n// import { getMyProducts, deleteProduct } from '@/api/product'\n\nexport default {\n  __name: 'MyItems',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const loading = ref(false);\n    const myProducts = ref([]);\n    onMounted(async () => {\n      fetchData();\n    });\n    const fetchData = async () => {\n      loading.value = true;\n      try {\n        // TODO: 调用API\n        // const res = await getMyProducts()\n        // myProducts.value = res.data\n\n        // 模拟数据\n        await new Promise(resolve => setTimeout(resolve, 500));\n        myProducts.value = [{\n          id: 1,\n          title: '二手高等数学教材',\n          price: 15.00,\n          category: '书籍教材',\n          status: 'active',\n          create_time: '2023-10-21 10:00:00',\n          image: ''\n        }, {\n          id: 2,\n          title: '罗技无线鼠标',\n          price: 45.00,\n          category: '电子数码',\n          status: 'sold',\n          create_time: '2023-10-20 15:30:00',\n          image: ''\n        }];\n      } catch (error) {\n        console.error(error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleEdit = row => {\n      ElMessage.info('编辑功能开发中...');\n    };\n    const handleDelete = row => {\n      ElMessageBox.confirm('确定要删除该商品吗？', '警告', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        // await deleteProduct(row.id)\n        ElMessage.success('删除成功');\n        fetchData(); // 重新加载\n      }).catch(() => {});\n    };\n    const __returned__ = {\n      router,\n      loading,\n      myProducts,\n      fetchData,\n      handleEdit,\n      handleDelete,\n      ref,\n      onMounted,\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      NavBar\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRouter","ElMessageBox","ElMessage","NavBar","router","loading","myProducts","fetchData","value","Promise","resolve","setTimeout","id","title","price","category","status","create_time","image","error","console","handleEdit","row","info","handleDelete","confirm","confirmButtonText","cancelButtonText","type","then","success","catch"],"sources":["D:/VsCodeProject/CampusTradingPlatform/frontend/src/views/MyItems.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-items-container\">\r\n    <NavBar />\r\n    \r\n    <div class=\"content-wrapper\">\r\n      <el-card>\r\n        <template #header>\r\n          <div class=\"card-header\">\r\n            <span>我的发布</span>\r\n            <el-button type=\"primary\" size=\"small\" @click=\"$router.push('/publish')\">发布新商品</el-button>\r\n          </div>\r\n        </template>\r\n        \r\n        <el-table :data=\"myProducts\" style=\"width: 100%\" v-loading=\"loading\">\r\n          <el-table-column prop=\"image\" label=\"图片\" width=\"100\">\r\n            <template #default=\"scope\">\r\n              <img v-if=\"scope.row.image\" :src=\"scope.row.image\" style=\"width: 60px; height: 60px; object-fit: cover\" />\r\n              <div v-else style=\"width: 60px; height: 60px; background: #f5f7fa; display: flex; align-items: center; justify-content: center; color: #909399; font-size: 12px;\">无图</div>\r\n            </template>\r\n          </el-table-column>\r\n          \r\n          <el-table-column prop=\"title\" label=\"商品标题\" min-width=\"200\" />\r\n          \r\n          <el-table-column prop=\"price\" label=\"价格\" width=\"120\">\r\n            <template #default=\"scope\">\r\n              <span style=\"color: #f56c6c; font-weight: bold;\">¥ {{ scope.row.price }}</span>\r\n            </template>\r\n          </el-table-column>\r\n          \r\n          <el-table-column prop=\"category\" label=\"分类\" width=\"120\">\r\n            <template #default=\"scope\">\r\n              <el-tag size=\"small\">{{ scope.row.category }}</el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          \r\n          <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n            <template #default=\"scope\">\r\n              <el-tag :type=\"scope.row.status === 'active' ? 'success' : 'info'\" size=\"small\">\r\n                {{ scope.row.status === 'active' ? '在售' : '已下架' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          \r\n          <el-table-column prop=\"create_time\" label=\"发布时间\" width=\"180\" />\r\n          \r\n          <el-table-column label=\"操作\" width=\"180\" fixed=\"right\">\r\n            <template #default=\"scope\">\r\n              <el-button size=\"small\" @click=\"handleEdit(scope.row)\">编辑</el-button>\r\n              <el-button \r\n                size=\"small\" \r\n                type=\"danger\" \r\n                @click=\"handleDelete(scope.row)\"\r\n              >删除</el-button>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessageBox, ElMessage } from 'element-plus'\r\nimport NavBar from '@/components/NavBar.vue'\r\n// import { getMyProducts, deleteProduct } from '@/api/product'\r\n\r\nconst router = useRouter()\r\nconst loading = ref(false)\r\nconst myProducts = ref([])\r\n\r\nonMounted(async () => {\r\n  fetchData()\r\n})\r\n\r\nconst fetchData = async () => {\r\n  loading.value = true\r\n  try {\r\n    // TODO: 调用API\r\n    // const res = await getMyProducts()\r\n    // myProducts.value = res.data\r\n    \r\n    // 模拟数据\r\n    await new Promise(resolve => setTimeout(resolve, 500))\r\n    myProducts.value = [\r\n      {\r\n        id: 1,\r\n        title: '二手高等数学教材',\r\n        price: 15.00,\r\n        category: '书籍教材',\r\n        status: 'active',\r\n        create_time: '2023-10-21 10:00:00',\r\n        image: ''\r\n      },\r\n      {\r\n        id: 2,\r\n        title: '罗技无线鼠标',\r\n        price: 45.00,\r\n        category: '电子数码',\r\n        status: 'sold',\r\n        create_time: '2023-10-20 15:30:00',\r\n        image: ''\r\n      }\r\n    ]\r\n  } catch (error) {\r\n    console.error(error)\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n\r\nconst handleEdit = (row) => {\r\n  ElMessage.info('编辑功能开发中...')\r\n}\r\n\r\nconst handleDelete = (row) => {\r\n  ElMessageBox.confirm(\r\n    '确定要删除该商品吗？',\r\n    '警告',\r\n    {\r\n      confirmButtonText: '确定',\r\n      cancelButtonText: '取消',\r\n      type: 'warning',\r\n    }\r\n  )\r\n    .then(async () => {\r\n      // await deleteProduct(row.id)\r\n      ElMessage.success('删除成功')\r\n      fetchData() // 重新加载\r\n    })\r\n    .catch(() => {})\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.my-items-container {\r\n  min-height: 100vh;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.content-wrapper {\r\n  max-width: 1000px;\r\n  margin: 20px auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n</style>"],"mappings":"AA8DA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,YAAY,EAAEC,SAAS,QAAQ,cAAc;AACtD,OAAOC,MAAM,MAAM,yBAAyB;AAC5C;;;;;;;;IAEA,MAAMC,MAAM,GAAGJ,SAAS,CAAC,CAAC;IAC1B,MAAMK,OAAO,GAAGP,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMQ,UAAU,GAAGR,GAAG,CAAC,EAAE,CAAC;IAE1BC,SAAS,CAAC,YAAY;MACpBQ,SAAS,CAAC,CAAC;IACb,CAAC,CAAC;IAEF,MAAMA,SAAS,GAAG,MAAAA,CAAA,KAAY;MAC5BF,OAAO,CAACG,KAAK,GAAG,